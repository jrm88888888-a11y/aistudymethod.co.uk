# ---------------------------------------------------------------------------
# aistudymethod.com — what never reaches the published site.
# The repo IS the live site (GitHub Pages serves main), so anything tracked is
# public. Retired content is deleted from git, not ignored: see README.md.
# ---------------------------------------------------------------------------

# OS / editor noise
.DS_Store
**/.DS_Store
Thumbs.db
*.swp

# Local development: tools scratch, notes, specification PDFs (boards' copyright)
_dev/
_tmp/
.tmp-*/
.scratch/
node_modules/
__pycache__/
*.pyc

# Staging areas for files to be removed by hand (the device bridge cannot delete)
/_to_delete/
_to_delete_locks/
_to_delete_probe/
classcraft/evaluate/_to_delete*/
classcraft/evaluate/_incoming/

# Backups and transfer archives — never commit; extract and commit the contents
*.bak
*.bak[0-9]
*.backup-*
*.fat-backup
*.pre-split-backup
*-backup-*.tar.gz
_velvet-backup/
*.tgz
*.tar.gz
*.zip
resources.js
resources.slim.js
