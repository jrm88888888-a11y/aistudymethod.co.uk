# --- repo hygiene (added by cleanup, 2026-07-28) ---
_dev/
node_modules/
**/.DS_Store
__pycache__/
*.pyc
*.bak
*.bak[0-9]
.scratch/
_tmp/
_to_delete_locks/
_to_delete_probe/
.tmp-*/

# Superseded by the anthropology|ibdp rename (2 Aug 2026). The IB has no Sociology
# subject; this content is IB Social and Cultural Anthropology and now lives at the
# anthropology-ibdp-* slug. The old files stay on disk but leave the published site.
# The old MINI-LESSON paths are deliberately NOT ignored - they remain as redirect stubs.
classcraft/adventures/sociology-ibdp-*-adventure-*.html
classcraft/adventures/_specs/sociology-ibdp-*
classcraft/evaluate/quizzes/sociology-ibdp-*
classcraft/evaluate/misconception-banks/sociology-ibdp-*
classcraft/view/curricula/sociology-ibdp-*
classcraft/spec-list/specs/sociology-ibdp-*
classcraft/arcade/vocab/sociology-ibdp-*

# Filenames containing '?' 404 on GitHub Pages - everything after the ? is read as a
# query string. Every one of these has a '?'-free twin; the originals leave the repo.
