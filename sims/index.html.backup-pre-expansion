    var parts = [];
    var h3 = card.querySelector('h3');
    var p = card.querySelector('p');
    var tag = card.querySelector('.tag');
    var slug = card.querySelector('.slug');
    if (h3) parts.push(h3.textContent);
    if (p) parts.push(p.textContent);
    if (tag) parts.push(tag.textContent);
    if (slug) parts.push(slug.textContent);
    return parts.join(' ').toLowerCase();
  });

  function applyFilter() {
    var q = input.value.trim().toLowerCase();
    var visible = 0;
    cards.forEach(function (card, i) {
      var match = q === '' || haystacks[i].indexOf(q) !== -1;
      if (match) {
        card.classList.remove('filtered-out');
        visible++;
      } else {
        card.classList.add('filtered-out');
      }
    });
    sections.forEach(function (sec) {
      var visibleInSection = sec.querySelectorAll('.card:not(.filtered-out)').length;
      if (visibleInSection === 0) {
        sec.classList.add('empty');
      } else {
        sec.classList.remove('empty');
      }
    });
    countEl.textContent = 'Showing ' + visible + ' of ' + total;
  }

  input.addEventListener('input', applyFilter);
})();
</script>
</body>
</html>
