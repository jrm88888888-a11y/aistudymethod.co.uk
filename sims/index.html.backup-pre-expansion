<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Interactive Simulations</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0a0e14;
    --bg-elev-1: #11161f;
    --bg-elev-2: #161d28;
    --panel: #131923;
    --panel-border: #1f2937;
    --grid: #1a2230;
    --grid-soft: #131a25;
    --text: #e6edf3;
    --text-dim: #97a1b0;
    --text-faint: #5b6573;
    --cyan: #22d3ee;
    --cyan-soft: rgba(34,211,238,0.18);
    --amber: #f59e0b;
    --amber-soft: rgba(245,158,11,0.20);
    --rose: #f43f5e;
    --rose-soft: rgba(244,63,94,0.20);
    --green: #34d399;
    --green-soft: rgba(52,211,153,0.18);
    --violet: #a78bfa;
    --gold: #fbbf24;
    --shadow: 0 8px 24px rgba(0,0,0,0.45);
    --r-sm: 6px;
    --r-md: 10px;
    --r-lg: 14px;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    font-family: 'Inter', -apple-system, system-ui, sans-serif;
    background: var(--bg);
    color: var(--text);
    font-size: 14px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
  }
  .num, .mono { font-family: 'JetBrains Mono', ui-monospace, monospace; font-variant-numeric: tabular-nums; }

  .page {
    max-width: 1280px;
    margin: 0 auto;
    padding: 64px 32px 96px;
  }

  /* Masthead */
  .masthead {
    border-bottom: 1px solid var(--panel-border);
    padding-bottom: 40px;
    margin-bottom: 48px;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 32px;
  }
  .masthead .brand {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cyan);
    margin-bottom: 18px;
  }
  .masthead h1 {
    margin: 0 0 14px;
    font-size: 44px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .masthead .blurb {
    color: var(--text-dim);
    font-size: 15px;
    line-height: 1.55;
    max-width: 640px;
    margin: 0;
  }
  .masthead .count {
    text-align: right;
    color: var(--text-dim);
    font-size: 12px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    letter-spacing: 0.04em;
  }
  .masthead .count .big {
    display: block;
    color: var(--text);
    font-size: 32px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1;
    margin-bottom: 6px;
  }

  /* Search */
  .search-row {
    margin-bottom: 32px;
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .search-input {
    width: 100%;
    max-width: 480px;
    padding: 12px 16px;
    background: var(--bg-elev-1);
    border: 1px solid var(--panel-border);
    border-radius: var(--r-md);
    color: var(--text);
    font-family: inherit;
    font-size: 14px;
    transition: border-color 160ms ease;
  }
  .search-input::placeholder { color: var(--text-faint); }
  .search-input:focus { outline: none; border-color: var(--cyan); }
  .search-count {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 12px;
    color: var(--text-dim);
    letter-spacing: 0.04em;
  }
  .card.filtered-out { display: none; }
  .section.empty .cards { display: none; }
  .section.empty .section-head { opacity: 0.4; }

  /* Section */
  section { margin-bottom: 48px; }
  .section-head {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding-bottom: 14px;
    margin-bottom: 18px;
    border-bottom: 1px solid var(--panel-border);
  }
  .section-head .index {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    color: var(--text-faint);
    letter-spacing: 0.05em;
  }
  .section-head h2 {
    margin: 0;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text);
  }
  .section-head .count-pill {
    margin-left: auto;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    color: var(--text-dim);
    padding: 2px 8px;
    border: 1px solid var(--panel-border);
    border-radius: 999px;
  }

  /* Cards */
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  @media (max-width: 980px) { .cards { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) {
    .cards { grid-template-columns: 1fr; }
    .masthead { grid-template-columns: 1fr; }
    .masthead .count { text-align: left; }
    .masthead h1 { font-size: 32px; }
    .page { padding: 40px 20px 64px; }
  }

  .card {
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-radius: var(--r-lg);
    padding: 20px;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 168px;
    position: relative;
    overflow: hidden;
    transition: border-color 160ms ease, transform 160ms ease, background 160ms ease;
  }
  .card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 80% at 0% 0%, rgba(34,211,238,0.06), transparent 50%);
    opacity: 0;
    transition: opacity 200ms ease;
    pointer-events: none;
  }
  .card:hover {
    border-color: var(--cyan);
    transform: translateY(-1px);
    background: var(--bg-elev-2);
  }
  .card:hover::before { opacity: 1; }
  .card:hover .launch { color: var(--cyan); transform: translateX(2px); }

  .card .preview {
    width: 100%;
    height: 80px;
    border-radius: 6px;
    background: #11161f;
    margin-bottom: 12px;
    border: 1px solid var(--panel-border);
    display: block;
  }
  .card .preview svg { width: 100%; height: 100%; display: block; }
  .card .slug {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10.5px;
    color: var(--text-faint);
    letter-spacing: 0.04em;
    margin-bottom: 2px;
  }
  .card h3 {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.005em;
  }
  .card p {
    margin: 0;
    color: var(--text-dim);
    font-size: 13px;
    line-height: 1.5;
    flex: 1;
  }
  .card .launch {
    margin-top: 6px;
    color: var(--text-dim);
    font-size: 12.5px;
    font-weight: 500;
    transition: color 160ms ease, transform 160ms ease;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    letter-spacing: 0.02em;
  }
  .card .tag {
    position: absolute;
    top: 16px;
    right: 16px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--text-faint);
    text-transform: uppercase;
  }

  /* Section accents */
  section[data-accent="cyan"]   .section-head h2 { color: var(--cyan); }
  section[data-accent="amber"]  .section-head h2 { color: var(--amber); }
  section[data-accent="green"]  .section-head h2 { color: var(--green); }
  section[data-accent="violet"] .section-head h2 { color: var(--violet); }

  /* Footer */
  footer {
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--panel-border);
    color: var(--text-faint);
    font-size: 11.5px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    display: flex;
    justify-content: space-between;
    align-items: center;
    letter-spacing: 0.04em;
  }
</style>
</head>
