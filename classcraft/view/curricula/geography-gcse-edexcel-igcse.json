  { "a": "river-environments", "b": "coastal-environments", "why": "Both are shaped by erosion, transport and deposition acting on water-driven systems" },
  { "a": "river-environments", "b": "hazardous-environments", "why": "River flooding is a major environmental hazard threatening communities" },
