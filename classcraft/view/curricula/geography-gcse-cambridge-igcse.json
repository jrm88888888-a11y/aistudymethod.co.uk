 "connections": [
  { "a": "population-dynamics", "b": "migration", "why": "Migration is a key driver of population change alongside birth and death rates" },
  { "a": "population-dynamics", "b": "settlements-and-service-provision", "why": "Population size and density shape the hierarchy of settlements and the services they support" },
  { "a": "settlements-and-service-provision", "b": "urban-settlements", "why": "Service provision and land-use models explain the internal structure of urban areas" },
  { "a": "migration", "b": "urbanisation", "why": "Rural-to-urban migration is a main cause of rapid urbanisation" },
  { "a": "urban-settlements", "b": "urbanisation", "why": "Urbanisation produces the growth, problems and management seen in urban settlements" },
  { "a": "earthquakes-and-volcanoes", "b": "settlements-and-service-provision", "why": "Tectonic hazards influence where people choose to settle despite the risks" },
  { "a": "rivers", "b": "coasts", "why": "Both depend on erosion, transport and deposition processes operating on different systems" },
  { "a": "weather", "b": "climate-and-natural-vegetation", "why": "Long-term weather patterns define the climate that determines natural vegetation" },
  { "a": "rivers", "b": "water", "why": "River systems are a primary source of the water resources societies manage" },
  { "a": "climate-and-natural-vegetation", "b": "food-production", "why": "Climate and soils set the limits on what farming systems can produce" },
  { "a": "development", "b": "industry", "why": "Industrialisation is closely tied to a country's level of economic development" },
  { "a": "development", "b": "population-dynamics", "why": "Levels of development drive demographic transition and population structure" },
  { "a": "industry", "b": "environmental-risks-of-economic-developm", "why": "Industrial growth generates pollution and other environmental risks" },
  { "a": "tourism", "b": "environmental-risks-of-economic-developm", "why": "Mass tourism can degrade the very environments it depends on" },
  { "a": "energy", "b": "environmental-risks-of-economic-developm", "why": "Fossil-fuel energy use is a leading cause of environmental degradation" },
  { "a": "energy", "b": "industry", "why": "Industry is a major consumer of energy resources" },
  { "a": "geographical-skills-and-fieldwork-core", "b": "rivers", "why": "River channel studies are a classic physical fieldwork enquiry requiring data skills" },
  { "a": "geographical-skills-and-fieldwork-core", "b": "urban-settlements", "why": "Urban land-use and quality-of-life surveys are common human fieldwork enquiries" }
