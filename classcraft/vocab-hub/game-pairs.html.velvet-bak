<header class="hd">
<div class="hd-left">
<a class="hd-logo" href="vocab-hub.html">AI <span>Study</span></a>
<span class="hd-sep">·</span>
<span class="hd-title" id="hd-title">Memory Match</span>
</div>
<div class="hd-right">
<div class="hd-right" id="hd-right" style="display:none;">
<div class="timer-wrap">
<span class="timer-label">Timer</span>
<label class="toggle"><input id="timer-toggle" type="checkbox"/><div class="toggle-track"></div><div class="toggle-thumb"></div></label>
</div>
<div class="hd-timer" id="hd-timer">3:00</div>
<div class="stat-pill">Pairs: <span id="match-count">0</span>/<span id="pair-total">12</span></div>
<div class="stat-pill">Moves: <span id="attempt-count">0</span></div>
<div class="stat-pill pill-acc">Accuracy: <span id="accuracy-live">—</span></div>
<div class="stat-pill streak-pill" id="streak-pill">🔥 ×<span id="streak-count">2</span></div>
<button class="btn-hd" id="btn-restart">↺ Change level</button>
</div>
<button class="btn-hd" id="btn-mute" title="Toggle sound (M)">🔊</button>
</div>
</header>
<div class="progress-bar"><div class="progress-fill" id="progress-fill"></div></div>
<div class="screen active" id="screen-start">
<h1 class="start-title" id="start-title">Memory Match</h1>
<div class="start-topic" id="start-topic"></div>
<p class="start-sub">Match each term to its definition. Choose how many pairs to play with.</p>
<div class="legend-row">
<div class="legend-item"><div class="legend-swatch term"></div>Blue = Term</div>
<div class="legend-item"><div class="legend-swatch def"></div>Green = Definition</div>
</div>
<div class="difficulty-grid" id="diff-grid"></div>
<button class="btn-start" id="btn-start" onclick="startGame()">Start Game →</button>
</div>
<div class="screen" id="screen-game">
<div class="card-grid" id="card-grid"></div>
</div>
<div class="overlay" id="overlay">
<div class="result-card">
<span class="result-emoji" id="res-emoji">🎉</span>
<h2 class="result-heading" id="res-heading">All matched!</h2>
<p class="result-sub" id="res-sub"></p>
<div class="result-stats">
<div class="result-stat"><div class="result-stat-val good" id="res-pairs">12</div><div class="result-stat-label">Pairs Found</div></div>
<div class="result-stat"><div class="result-stat-val neutral" id="res-attempts">0</div><div class="result-stat-label">Attempts</div></div>
<div class="result-stat"><div class="result-stat-val time" id="res-accuracy">100%</div><div class="result-stat-label">Accuracy</div></div>
</div>
<button class="btn-retry" id="btn-retry">Play Again (same level)</button>
<button class="btn-change" id="btn-change">Choose different level</button>
</div>
</div>
<script>
// ── Load vocab from sessionStorage ──
const VOCAB_DATA = JSON.parse(sessionStorage.getItem('vocab') || '[]');
const META       = JSON.parse(sessionStorage.getItem('vocabMeta') || '{}');

if (!VOCAB_DATA.length) {
  document.body.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100vh;color:#8b90a8;font-family:sans-serif;text-align:center;padding:2rem;"><div><p style="font-size:1.2rem;margin-bottom:1rem">This game needs a vocabulary list first.</p><a href="vocab-hub.html?game=pairs" style="color:#4ade9a">Choose your subject &amp; topic →</a></div></div>';
}

// ── Set title ──
if (META.topic) {
  document.getElementById('hd-title').textContent = `${META.topic} — Memory Match`;
  document.getElementById('start-title').textContent = META.topic;
  document.getElementById('start-topic').textContent = `${META.subject || ''} · ${META.board || ''}`;
}

const REDUCED_MOTION = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

/* ============================================================
   AUDIO — tiny WebAudio synth, no assets, mutable (persisted)
   (base copied from game-spaceinvaders.html — shared 'aism-muted' key)
   ============================================================ */
const AudioFX = (() => {
  let actx = null, master = null;
  let muted = false;
  try { muted = localStorage.getItem('aism-muted') === '1'; } catch (e) {}

  function ensure() {
    try {
      if (!actx) {
        const AC = window.AudioContext || window.webkitAudioContext;
        if (!AC) return false;
        actx = new AC();
        master = actx.createGain();
        master.gain.value = 0.4;
        master.connect(actx.destination);
      }
      if (actx.state === 'suspended') actx.resume();
      return true;
    } catch (e) { return false; }
  }

  function tone(freq, dur, type, vol, endFreq) {
    if (muted || !ensure()) return;
    try {
      const t0 = actx.currentTime;
      const o = actx.createOscillator(), g = actx.createGain();
      o.type = type || 'square';
      o.frequency.setValueAtTime(freq, t0);
      if (endFreq) o.frequency.exponentialRampToValueAtTime(Math.max(30, endFreq), t0 + dur);
      g.gain.setValueAtTime(vol || 0.15, t0);
      g.gain.exponentialRampToValueAtTime(0.001, t0 + dur);
      o.connect(g); g.connect(master);
      o.start(t0); o.stop(t0 + dur + 0.02);
    } catch (e) {}
  }

  function noise(dur, vol, filterFreq) {
    if (muted || !ensure()) return;
    try {
      const t0 = actx.currentTime;
      const len = Math.max(1, Math.floor(actx.sampleRate * dur));
      const buf = actx.createBuffer(1, len, actx.sampleRate);
      const d = buf.getChannelData(0);
      for (let i = 0; i < len; i++) d[i] = Math.random() * 2 - 1;
      const src = actx.createBufferSource(); src.buffer = buf;
      const f = actx.createBiquadFilter(); f.type = 'lowpass';
      f.frequency.setValueAtTime(filterFreq || 1200, t0);
      f.frequency.exponentialRampToValueAtTime(120, t0 + dur);
      const g = actx.createGain();
      g.gain.setValueAtTime(vol || 0.25, t0);
      g.gain.exponentialRampToValueAtTime(0.001, t0 + dur);
      src.connect(f); f.connect(g); g.connect(master);
      src.start(t0);
    } catch (e) {}
  }

  return {
    unlock() { ensure(); },
    get muted() { return muted; },
    toggleMute() {
      muted = !muted;
      try { localStorage.setItem('aism-muted', muted ? '1' : '0'); } catch (e) {}
      return muted;
    },
    flip()     { tone(640, 0.05, 'sine', 0.07, 540); },
    match()    { tone(523, 0.1, 'sine', 0.14); setTimeout(() => tone(784, 0.16, 'sine', 0.14), 95); },
    mismatch() { tone(185, 0.22, 'sawtooth', 0.08, 95); },
    fanfare()  { tone(523, 0.12, 'sine', 0.15); setTimeout(() => tone(659, 0.12, 'sine', 0.15), 110); setTimeout(() => tone(784, 0.12, 'sine', 0.15), 220); setTimeout(() => tone(1047, 0.32, 'sine', 0.16), 330); },
  };
})();

/* ── Mute button + M key ── */
const muteBtn = document.getElementById('btn-mute');
if (muteBtn) {
  muteBtn.textContent = AudioFX.muted ? '🔇' : '🔊';
  muteBtn.addEventListener('click', () => {
    muteBtn.textContent = AudioFX.toggleMute() ? '🔇' : '🔊';
    muteBtn.blur();
  });
  document.addEventListener('keydown', (e) => {
    if ((e.key === 'm' || e.key === 'M') && !e.repeat && !e.metaKey && !e.ctrlKey && !e.altKey) {
      muteBtn.textContent = AudioFX.toggleMute() ? '🔇' : '🔊';
    }
  });
}

// ── Difficulty options ──
const DIFF_OPTIONS = [
  { icon:'🌱', label:'Starter',   pairs:4  },
  { icon:'⚡', label:'Standard',  pairs:6  },
  { icon:'🔥', label:'Challenge', pairs:8  },
  { icon:'💀', label:'Expert',    pairs:10 },
  { icon:'🏆', label:'Master',    pairs:12 },
  { icon:'👾', label:'Legend',    pairs:VOCAB_DATA.length },
];

const GRID_COLS = { 4:4, 6:4, 8:4, 10:5, 12:6 };
const GRID_ROWS = { 4:2, 6:3, 8:4, 10:4, 12:4 };
const TIMER_SECS = { 4:90, 6:120, 8:150, 10:180, 12:210 };

let selectedPairs=0, flipped=[], matched=new Set(), attempts=0;
let locked=false, gameOver=false, streak=0, dealToken=0;
let timerOn=false, timerSecs=120, timerInterval=null, timerPausedByTab=false;

// Build difficulty grid
const diffGrid = document.getElementById('diff-grid');
DIFF_OPTIONS.forEach(opt => {
  const n = Math.min(opt.pairs, VOCAB_DATA.length);
  const card = document.createElement('div');
  card.className = 'diff-card' + (VOCAB_DATA.length < opt.pairs ? ' disabled' : '');
  card.dataset.pairs = n;
  card.innerHTML = `<span class="diff-icon">${opt.icon}</span><div class="diff-label">${opt.label}</div><div class="diff-detail">${n} pairs</div>`;
  card.addEventListener('click', () => {
    document.querySelectorAll('.diff-card').forEach(c=>c.classList.remove('selected'));
    card.classList.add('selected');
    selectedPairs = n;
    document.getElementById('btn-start').classList.add('ready');
    document.getElementById('btn-start').textContent = `Start — ${n} pairs →`;
  });
  diffGrid.appendChild(card);
});

function shuffle(arr){const a=[...arr];for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;}

function startGame(){
  if(!selectedPairs)return;
  AudioFX.unlock();
  document.getElementById('screen-start').classList.remove('active');
  document.getElementById('screen-game').classList.add('active');
  document.getElementById('hd-right').style.display='flex';
  document.getElementById('pair-total').textContent=selectedPairs;
  resetState();
  buildGrid();
  if(timerOn)startTimer();
}

function resetState(){
  flipped=[];matched=new Set();attempts=0;locked=false;gameOver=false;streak=0;
  updateStreak();updateAccuracy();
  document.getElementById('match-count').textContent='0';
  document.getElementById('attempt-count').textContent='0';
  document.getElementById('progress-fill').style.width='0%';
  document.getElementById('overlay').classList.remove('open');
  stopTimer();
  timerSecs=TIMER_SECS[selectedPairs]||180;
  updateTimerDisplay();
}

function buildGrid(){
  const grid=document.getElementById('card-grid');
  grid.innerHTML='';
  const cols=GRID_COLS[selectedPairs]||6;
  const rows=GRID_ROWS[selectedPairs]||4;
  const screenEl=document.getElementById('screen-game');
  const availW=screenEl.clientWidth-16;
  const availH=screenEl.clientHeight-16;
  const gap=6;
  const cardW=Math.floor((availW-gap*(cols-1))/cols);
  const cardH=Math.floor((availH-gap*(rows-1))/rows);
  grid.style.gridTemplateColumns=`repeat(${cols},${cardW}px)`;
  grid.style.gridTemplateRows=`repeat(${rows},${cardH}px)`;
  grid.style.gap=gap+'px';
  grid.style.width=(cardW*cols+gap*(cols-1))+'px';
  grid.style.height=(cardH*rows+gap*(rows-1))+'px';
  const fs=cardH<60?'0.52rem':cardH<80?'0.62rem':cardH<100?'0.72rem':'0.82rem';
  const pool=shuffle([...VOCAB_DATA]).slice(0,selectedPairs);
  let cards=[];
  pool.forEach((item,i)=>{
    cards.push({pairId:i,type:'term',text:item.term});
    cards.push({pairId:i,type:'def', text:item.definition});
  });
  cards=shuffle(cards);
  cards.forEach((c,idx)=>{
    const card=document.createElement('div');
    card.className='card';
    card.dataset.pairId=c.pairId;
    card.dataset.type=c.type;
    card.innerHTML=`<div class="card-inner"><div class="card-face card-back"><div class="card-back-inner"><div class="card-back-pattern"></div><span class="card-back-logo">ME</span></div></div><div class="card-face card-front ${c.type}"><span class="card-type-badge">${c.type==='term'?'Term':'Definition'}</span><span class="card-text" style="font-size:${fs}">${c.text}</span></div></div>`;
    card.addEventListener('click',()=>onCardClick(card));
    if(!REDUCED_MOTION){
      const delay=Math.min(idx*35,1100);
      card.classList.add('deal');
      card.style.animationDelay=delay+'ms';
      card.addEventListener('animationend',function h(e){
        if(e.animationName==='dealIn'){card.classList.remove('deal');card.style.animationDelay='';card.removeEventListener('animationend',h);}
      });
    }
    grid.appendChild(card);
  });
  // Brief input lock while the deal-in plays (no flipping mid-deal)
  if(!REDUCED_MOTION){
    locked=true;
    const token=++dealToken;
    const dealTotal=Math.min((cards.length-1)*35,1100)+460;
    setTimeout(()=>{if(token===dealToken&&!gameOver&&flipped.length===0)locked=false;},dealTotal);
  }
}

function onCardClick(card){
  if(locked||gameOver)return;
  if(card.classList.contains('flipped')||card.classList.contains('matched'))return;
  if(flipped.length>=2)return;
  card.classList.add('flipped');
  AudioFX.flip();
  flipped.push(card);
  if(flipped.length===2)checkMatch();
}

function checkMatch(){
  locked=true;attempts++;
  document.getElementById('attempt-count').textContent=attempts;
  const[a,b]=flipped;
  const isMatch=a.dataset.pairId===b.dataset.pairId&&a.dataset.type!==b.dataset.type;
  if(isMatch){
    streak++;
    setTimeout(()=>{
      a.classList.add('matched','just-matched');b.classList.add('matched','just-matched');
      a.classList.remove('flipped');b.classList.remove('flipped');
      setTimeout(()=>{a.classList.remove('just-matched');b.classList.remove('just-matched');},1400);
      matched.add(parseInt(a.dataset.pairId));
      flipped=[];locked=false;
      AudioFX.match();
      sparkleBurst(a,'#4ade9a');sparkleBurst(b,'#4ade9a');
      comboFloat(a,b);
      updateStreak();updateProgress();updateAccuracy();
      if(matched.size===selectedPairs)setTimeout(endGame,500);
    },300);
  }else{
    streak=0;
    setTimeout(()=>{a.classList.add('wrong');b.classList.add('wrong');AudioFX.mismatch();},150);
    setTimeout(()=>{a.classList.remove('flipped','wrong');b.classList.remove('flipped','wrong');flipped=[];locked=false;updateStreak();updateAccuracy();},950);
  }
}

function updateProgress(){
  document.getElementById('progress-fill').style.width=(matched.size/selectedPairs*100)+'%';
  document.getElementById('match-count').textContent=matched.size;
}

function updateAccuracy(){
  const el=document.getElementById('accuracy-live');
  if(el)el.textContent=attempts>0?Math.round(matched.size/attempts*100)+'%':'—';
}

function updateStreak(){
  const pill=document.getElementById('streak-pill');
  if(!pill)return;
  if(streak>=2){document.getElementById('streak-count').textContent=streak;pill.classList.add('on');}
  else pill.classList.remove('on');
}

/* ── DOM particle FX (all self-cleaning, reduced-motion gated) ── */
function sparkleBurst(el,colour){
  if(REDUCED_MOTION||!el)return;
  const r=el.getBoundingClientRect();
  const cx=r.left+r.width/2, cy=r.top+r.height/2;
  for(let i=0;i<8;i++){
    const b=document.createElement('div');
    b.className='fx-bit';
    const size=3+Math.random()*4;
    b.style.cssText=`left:${cx}px;top:${cy}px;width:${size}px;height:${size}px;background:${colour};border-radius:50%;box-shadow:0 0 6px ${colour};`;
    document.body.appendChild(b);
    if(!b.animate){b.remove();return;}
    const ang=Math.random()*Math.PI*2, dist=28+Math.random()*48;
    const anim=b.animate(
      [{transform:'translate(0,0) scale(1)',opacity:1},
       {transform:`translate(${Math.cos(ang)*dist}px,${Math.sin(ang)*dist-14}px) scale(0)`,opacity:0}],
      {duration:450+Math.random()*250,easing:'cubic-bezier(0.25,0.46,0.45,0.94)'});
    anim.onfinish=()=>b.remove();
    setTimeout(()=>b.remove(),1000);
  }
}

function comboFloat(elA,elB){
  if(streak<2)return;
  const ra=elA.getBoundingClientRect(),rb=elB.getBoundingClientRect();
  const x=(ra.left+ra.width/2+rb.left+rb.width/2)/2;
  const y=Math.min(ra.top,rb.top);
  const f=document.createElement('div');
  f.className='combo-float';
  f.textContent=`🔥 ×${streak}`;
  f.style.cssText=`left:${x}px;top:${y}px;font-size:${Math.min(1.6,0.95+streak*0.1)}rem;transform:translate(-50%,-100%);`;
  document.body.appendChild(f);
  if(!REDUCED_MOTION&&f.animate){
    const a=f.animate(
      [{transform:'translate(-50%,-100%) scale(0.7)',opacity:0},
       {transform:'translate(-50%,-135%) scale(1)',opacity:1,offset:0.25},
       {transform:'translate(-50%,-195%) scale(1)',opacity:0}],
      {duration:850,easing:'ease-out'});
    a.onfinish=()=>f.remove();
    setTimeout(()=>f.remove(),1300);
  }else{
    setTimeout(()=>f.remove(),700);
  }
}

function confettiBurst(){
  if(REDUCED_MOTION)return;
  const colours=['#4ade9a','#7b6fff','#ffd166','#5ac8ff','#ff6b6b'];
  const bits=[];
  for(let i=0;i<70;i++){
    const b=document.createElement('div');
    b.className='fx-bit';
    const w=5+Math.random()*5;
    b.style.cssText=`left:${Math.random()*100}vw;top:-14px;width:${w}px;height:${w*0.45}px;background:${colours[i%colours.length]};`;
    document.body.appendChild(b);bits.push(b);
    if(!b.animate){b.remove();continue;}
    const a=b.animate(
      [{transform:'translate(0,0) rotate(0deg)',opacity:1},
       {transform:`translate(${(Math.random()*2-1)*130}px,${window.innerHeight+50}px) rotate(${(Math.random()*2-1)*720}deg)`,opacity:0.7}],
      {duration:1400+Math.random()*1400,delay:Math.random()*250,easing:'cubic-bezier(0.3,0.4,0.6,1)',fill:'forwards'});
    a.onfinish=()=>b.remove();
  }
  setTimeout(()=>bits.forEach(b=>b.remove()),3400);
}

function countUp(el,target,suffix){
  if(REDUCED_MOTION||!window.requestAnimationFrame){el.textContent=target+(suffix||'');return;}
  const t0=performance.now(),dur=700;
  function step(now){
    const k=Math.min(1,(now-t0)/dur);
    el.textContent=Math.round(target*(1-Math.pow(1-k,3)))+(suffix||'');
    if(k<1)requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}

function endGame(){
  if(gameOver)return;gameOver=true;stopTimer();
  const won=matched.size===selectedPairs;
  const accuracy=attempts>0?Math.round(matched.size/attempts*100):(won?100:0);
  const[emoji,h,s]=!won?['⏰','Time\'s up!','You matched '+matched.size+' of '+selectedPairs+' pairs.']:accuracy===100?['🏆','Perfect!','First attempt on every pair!']:accuracy>=80?['🎉','Excellent!','Really strong performance.']:accuracy>=60?['👍','Well done!','Keep practising.']:['📚','Keep going!','Review and try again.'];
  document.getElementById('res-emoji').textContent=emoji;
  document.getElementById('res-heading').textContent=h;
  document.getElementById('res-sub').textContent=s;
  countUp(document.getElementById('res-pairs'),matched.size,'');
  countUp(document.getElementById('res-attempts'),attempts,'');
  countUp(document.getElementById('res-accuracy'),accuracy,'%');

  /* Personal best — stored locally per topic (best accuracy %) */
  try {
    const bestKey = `aism-best:pairs:${META.subject || ''}:${META.topic || ''}`;
    const prevRaw = localStorage.getItem(bestKey);
    const prev = prevRaw == null ? null : parseInt(prevRaw, 10);
    const isNew = prev == null || accuracy > prev;
    if (isNew && won) localStorage.setItem(bestKey, String(accuracy));
    if (prev != null) {
      document.getElementById('res-sub').textContent +=
        (isNew && won) ? ` 🎉 New personal best (was ${prev}%)!` : ` Personal best: ${prev}%.`;
    }
  } catch (e) {}

  if(won){AudioFX.fanfare();confettiBurst();}
  document.getElementById('overlay').classList.add('open');
}

function timerTick(){timerSecs--;updateTimerDisplay();if(timerSecs<=0){stopTimer();endGame();}}
function startTimer(){timerSecs=TIMER_SECS[selectedPairs]||180;updateTimerDisplay();stopTimer();timerInterval=setInterval(timerTick,1000);}
function resumeTimer(){stopTimer();timerInterval=setInterval(timerTick,1000);}
function stopTimer(){clearInterval(timerInterval);timerInterval=null;}

/* Freeze countdown while the tab is hidden */
document.addEventListener('visibilitychange',()=>{
  if(document.hidden){
    if(timerInterval){stopTimer();timerPausedByTab=true;}
  }else if(timerPausedByTab){
    timerPausedByTab=false;
    if(timerOn&&!gameOver)resumeTimer();
  }
});
function updateTimerDisplay(){const m=Math.floor(timerSecs/60),s=timerSecs%60;const el=document.getElementById('hd-timer');if(!el)return;el.textContent=`${m}:${s.toString().padStart(2,'0')}`;el.classList.toggle('urgent',timerSecs<=20);}
document.getElementById('timer-toggle').addEventListener('change',function(){timerOn=this.checked;document.getElementById('hd-timer').classList.toggle('active',timerOn);stopTimer();if(timerOn&&!gameOver)startTimer();});

function goToStart(){document.getElementById('overlay').classList.remove('open');document.getElementById('screen-game').classList.remove('active');document.getElementById('screen-start').classList.add('active');document.getElementById('hd-right').style.display='none';stopTimer();}
function restart(){document.getElementById('overlay').classList.remove('open');resetState();buildGrid();if(timerOn)startTimer();}
document.getElementById('btn-restart').addEventListener('click',goToStart);
document.getElementById('btn-retry').addEventListener('click',restart);
document.getElementById('btn-change').addEventListener('click',goToStart);
</script>
<!-- aism-study-screen:v1 -->
<style id="aism-study-css">
#aism-study-overlay {
  position: fixed; inset: 0; background: rgba(15,17,23,0.94);
  z-index: 99999; display: none; align-items: center; justify-content: center;
  padding: 24px; overflow-y: auto;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
}
#aism-study-overlay[data-show="1"] { display: flex; }
.aism-study-card {
  background: #fff; color: #1a1a1a; max-width: 760px; width: 100%;
  max-height: 90vh; overflow-y: auto; border-radius: 18px; padding: 32px;
  box-shadow: 0 20px 60px rgba(0,0,0,0.4);
}
.aism-study-card h2 {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 26px; margin: 0 0 6px; color: #1a1a1a; line-height: 1.2;
}
.aism-study-card .aism-study-sub {
  color: #555; font-size: 14px; margin: 0 0 20px; line-height: 1.5;
}
#aism-study-content { display: grid; gap: 8px; margin-bottom: 24px; }
.aism-study-item {
  padding: 12px 16px; background: #f6f7f9; border-radius: 10px;
  font-size: 14px; line-height: 1.55; color: #1a1a1a;
}
.aism-study-item .aism-term {
  font-weight: 700; color: #267a4d;
}
.aism-study-cat { margin-top: 14px; }
.aism-study-cat:first-child { margin-top: 0; }
.aism-study-cat-head {
  font-size: 12px; font-weight: 700; color: #267a4d;
  text-transform: uppercase; letter-spacing: 1.5px; margin: 0 0 8px;
}
.aism-study-btn {
  background: #267a4d; color: #fff; border: none;
  padding: 14px 30px; border-radius: 30px;
  font-size: 15px; font-weight: 600; cursor: pointer; width: 100%;
  transition: background 0.15s ease;
}
.aism-study-btn:hover { background: #1e6240; }
.aism-study-skip {
  background: none; border: none; color: #888; font-size: 12px;
  cursor: pointer; margin-top: 12px; width: 100%; padding: 8px;
  text-decoration: underline;
}
.aism-study-skip:hover { color: #555; }
</style>
<div id="aism-study-overlay" aria-hidden="true">
  <div class="aism-study-card" role="dialog" aria-modal="true" aria-label="Study these before you play">
    <h2 id="aism-study-title">Study first &mdash; then play to test your memory</h2>
    <p class="aism-study-sub">Take your time. When you&rsquo;re ready, start the game.</p>
    <div id="aism-study-content"></div>
    <button id="aism-study-start" class="aism-study-btn" type="button">I&rsquo;m ready &mdash; start game &rarr;</button>
    <button id="aism-study-skip" class="aism-study-skip" type="button">Skip and go straight to game</button>
  </div>
</div>
<script>
(function(){
  if (window.__aismStudyInstalled) return;
  window.__aismStudyInstalled = true;
  function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g, function(c){return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c];}); }
  function buildContent(){
    var c = document.getElementById('aism-study-content');
    if (!c) return false;
    c.innerHTML = '';
    var rendered = false;
    var pairs = null;
    if (typeof ALL_PAIRS !== 'undefined' && Array.isArray(ALL_PAIRS) && ALL_PAIRS.length) pairs = ALL_PAIRS;
    else if (typeof VOCAB_DATA !== 'undefined' && Array.isArray(VOCAB_DATA) && VOCAB_DATA.length) pairs = VOCAB_DATA;
    if (pairs) {
      pairs.forEach(function(p){
        var term = p.term || p.front || p.word || '';
        var def  = p.def || p.definition || p.back || '';
        var div = document.createElement('div');
        div.className = 'aism-study-item';
        div.innerHTML = '<span class="aism-term">' + esc(term) + '</span>' + (def ? ' &mdash; ' + esc(def) : '');
        c.appendChild(div);
      });
      rendered = true;
    }
    if (!rendered && typeof CATEGORIES !== 'undefined' && typeof ALL_ITEMS !== 'undefined' && Array.isArray(CATEGORIES) && Array.isArray(ALL_ITEMS)) {
      CATEGORIES.forEach(function(catName, idx){
        var wrap = document.createElement('div'); wrap.className = 'aism-study-cat';
        var h = document.createElement('div'); h.className = 'aism-study-cat-head'; h.textContent = catName; wrap.appendChild(h);
        ALL_ITEMS.filter(function(i){ return i.cat === idx; }).forEach(function(i){
          var d = document.createElement('div'); d.className = 'aism-study-item';
          d.textContent = i.text || i.label || '';
          wrap.appendChild(d);
        });
        c.appendChild(wrap);
      });
      rendered = true;
    }
    if (!rendered && typeof ALL_EVENTS !== 'undefined' && Array.isArray(ALL_EVENTS) && ALL_EVENTS.length) {
      var sorted = ALL_EVENTS.slice().sort(function(a,b){
        var ay = parseInt(String(a.year||a.date||'0').replace(/[^-\d]/g,''))||0;
        var by = parseInt(String(b.year||b.date||'0').replace(/[^-\d]/g,''))||0;
        return ay - by;
      });
      sorted.forEach(function(e){
        var div = document.createElement('div');
        div.className = 'aism-study-item';
        div.innerHTML = '<span class="aism-term">' + esc(e.year || e.date || '') + '</span>' + (e.text ? ' &mdash; ' + esc(e.text) : '');
        c.appendChild(div);
      });
      rendered = true;
    }
    return rendered;
  }
  function install(){
    if (typeof window.startGame !== 'function') { setTimeout(install, 80); return; }
    var orig = window.startGame;
    var shown = false;
    window.startGame = function(){
      if (shown) return orig.apply(this, arguments);
      var args = arguments, ctx = this;
      var ov = document.getElementById('aism-study-overlay');
      if (!ov || !buildContent()) return orig.apply(ctx, args);
      ov.dataset.show = '1';
      ov.setAttribute('aria-hidden','false');
      var startBtn = document.getElementById('aism-study-start');
      var skipBtn  = document.getElementById('aism-study-skip');
      function go(){
        ov.dataset.show = '';
        ov.setAttribute('aria-hidden','true');
        shown = true;
        try { orig.apply(ctx, args); } catch(e){ console.error(e); }
      }
      startBtn.onclick = go;
      skipBtn.onclick  = go;
    };
  }
  if (document.readyState === 'complete' || document.readyState === 'interactive') install();
  else document.addEventListener('DOMContentLoaded', install);
})();
</script>

</body>
</html>
