<!DOCTYPE html>

<html lang="en">
<head><link href="../../style.css" rel="stylesheet"/>
<script src="../../script.js" defer></script>

<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Flashcard Pairs | Free Vocabulary Revision Game — AI Study Method</title>
<meta content="Play Flashcard Pairs — a free vocabulary revision game covering 3,500+ terms across 18 subjects. No login required. Try it now." name="description"/>
<link rel="canonical" href="https://aistudymethod.co.uk/classcraft/vocab-hub/game-pairs.html">
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&amp;display=swap" rel="stylesheet"/>
<style>
    :root {
      --bg:#0f1117; --surface:#1a1d27; --surface2:#22253a;
      --border:rgba(255,255,255,0.08); --border-hi:rgba(255,255,255,0.14);
      --accent:#4ade9a; --accent2:#7b6fff; --warn:#ff6b6b;
      --text:#e8eaf0; --text-mid:#8b90a8; --text-dim:#4a4f68;
      --correct:#4ade9a; --wrong:#ff6b6b;
      --term-bg:#1e2440; --term-edge:#4a5aaa;
      --def-bg:#1e2e28;  --def-edge:#3a8a5a;
      --font-d:'Nunito',sans-serif; --font-b:'Nunito',sans-serif;
      --r:10px; --trans:0.18s cubic-bezier(0.25,0.46,0.45,0.94);
    }
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
    html,body{height:100%;overflow:hidden;}
    body{background:var(--bg);color:var(--text);font-family:var(--font-b);font-size:15px;line-height:1.5;display:flex;flex-direction:column;height:100vh;height:100dvh;}
    .hd{background:var(--surface);border-bottom:1px solid var(--border);padding:0 1.25rem;height:52px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0;gap:0.75rem;}
    .hd-left{display:flex;align-items:center;gap:0.85rem;min-width:0;}
    .hd-logo{font-family:var(--font-d);font-size:1.05rem;font-weight:800;color:var(--text);text-decoration:none;letter-spacing:-0.02em;flex-shrink:0;}
    .hd-logo span{color:var(--accent);}
    .hd-title{font-family:var(--font-d);font-size:0.8rem;font-weight:600;color:var(--text-mid);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0;}
    .hd-sep{color:var(--text-dim);flex-shrink:0;}
    .hd-right{display:flex;align-items:center;gap:0.5rem;flex-shrink:0;}
    .timer-wrap{display:flex;align-items:center;gap:0.4rem;}
    .timer-label{font-size:0.65rem;font-weight:500;letter-spacing:0.07em;text-transform:uppercase;color:var(--text-mid);}
    .toggle{position:relative;width:34px;height:19px;cursor:pointer;flex-shrink:0;}
    .toggle input{opacity:0;width:0;height:0;position:absolute;}
    .toggle-track{position:absolute;inset:0;background:var(--surface2);border:1px solid var(--border-hi);border-radius:20px;transition:background var(--trans),border-color var(--trans);}
    .toggle input:checked+.toggle-track{background:var(--accent2);border-color:var(--accent2);}
    .toggle-thumb{position:absolute;top:3px;left:3px;width:11px;height:11px;background:var(--text-mid);border-radius:50%;transition:transform var(--trans),background var(--trans);}
    .toggle input:checked~.toggle-thumb{transform:translateX(15px);background:#fff;}
    .hd-timer{font-family:var(--font-d);font-size:0.82rem;font-weight:700;color:var(--accent2);background:var(--surface2);border:1px solid var(--border-hi);border-radius:var(--r);padding:0.22rem 0.6rem;min-width:46px;text-align:center;display:none;}
    .hd-timer.active{display:block;}
    .hd-timer.urgent{color:var(--warn);animation:pulse 0.5s ease infinite alternate;}
    @keyframes pulse{from{opacity:1}to{opacity:0.35}}
    .stat-pill{font-family:var(--font-d);font-size:0.75rem;font-weight:700;color:var(--text);background:var(--surface2);border:1px solid var(--border-hi);border-radius:var(--r);padding:0.22rem 0.6rem;white-space:nowrap;}
    .stat-pill span{color:var(--accent);}
    .btn-hd{font-family:var(--font-d);font-size:0.65rem;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;background:transparent;border:1px solid var(--border-hi);color:var(--text-mid);padding:0.22rem 0.75rem;border-radius:var(--r);cursor:pointer;transition:all var(--trans);white-space:nowrap;}
    .btn-hd:hover{border-color:var(--accent);color:var(--accent);}
    .progress-bar{height:3px;background:var(--surface2);flex-shrink:0;}
    .progress-fill{height:100%;background:linear-gradient(90deg,var(--accent2),var(--accent));width:0%;transition:width 0.5s ease;box-shadow:0 0 6px rgba(74,222,154,0.5);}
    .screen{flex:1;display:none;flex-direction:column;align-items:center;justify-content:center;padding:1.5rem;overflow-y:auto;min-height:0;}
    .screen.active{display:flex;}
    .start-title{font-family:var(--font-d);font-size:clamp(1.4rem,3vw,1.8rem);font-weight:800;letter-spacing:-0.03em;margin-bottom:0.3rem;text-align:center;}
    .start-topic{font-family:var(--font-d);font-size:0.78rem;font-weight:600;color:var(--accent2);text-align:center;margin-bottom:1.25rem;letter-spacing:0.05em;}
    .start-sub{color:var(--text-mid);font-size:0.85rem;margin-bottom:1.5rem;text-align:center;max-width:44ch;}
    .legend-row{display:flex;gap:1.5rem;margin-bottom:1.5rem;}
    .legend-item{display:flex;align-items:center;gap:0.45rem;font-size:0.75rem;color:var(--text-mid);}
    .legend-swatch{width:26px;height:16px;border-radius:4px;border:1.5px solid;}
    .legend-swatch.term{background:var(--term-bg);border-color:var(--term-edge);}
    .legend-swatch.def{background:var(--def-bg);border-color:var(--def-edge);}
    .difficulty-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0.6rem;width:100%;max-width:480px;margin-bottom:1.5rem;}
    .diff-card{background:var(--surface);border:2px solid var(--border-hi);border-radius:12px;padding:1rem 0.75rem;text-align:center;cursor:pointer;transition:border-color var(--trans),transform var(--trans),background var(--trans);user-select:none;}
    .diff-card:hover{border-color:var(--accent2);transform:translateY(-2px);}
    .diff-card:active{transform:translateY(0);}
    .diff-card.selected{border-color:var(--accent);background:rgba(74,222,154,0.07);}
    .diff-card.disabled{opacity:0.3;pointer-events:none;}
    .diff-icon{font-size:1.5rem;margin-bottom:0.3rem;display:block;}
    .diff-label{font-family:var(--font-d);font-size:0.85rem;font-weight:700;margin-bottom:0.15rem;}
    .diff-detail{font-size:0.68rem;color:var(--text-mid);}
    .btn-start{font-family:var(--font-d);font-size:0.85rem;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;background:var(--accent);color:#0f1117;border:none;padding:0.85rem 2.5rem;border-radius:var(--r);cursor:pointer;transition:all var(--trans);opacity:0.3;pointer-events:none;}
    .btn-start.ready{opacity:1;pointer-events:all;}
    .btn-start.ready:hover{background:#6ef0b0;transform:translateY(-1px);box-shadow:0 4px 20px rgba(74,222,154,0.35);}
    .btn-start.ready:active{transform:translateY(0);box-shadow:none;}
    #screen-game{padding:0.5rem;justify-content:center;}
    .card-grid{display:grid;gap:0.4rem;flex-shrink:0;}
    .card{cursor:pointer;perspective:800px;min-height:0;}
    .card-inner{position:relative;width:100%;height:100%;transform-style:preserve-3d;transition:transform 0.42s cubic-bezier(0.4,0.2,0.2,1);}
    .card.flipped .card-inner,.card.matched .card-inner{transform:rotateY(180deg);}
    .card-face{position:absolute;inset:0;border-radius:8px;display:flex;align-items:center;justify-content:center;padding:0.3rem 0.4rem;backface-visibility:hidden;-webkit-backface-visibility:hidden;text-align:center;overflow:hidden;}
    .card-back{background:var(--surface2);border:1.5px solid var(--border-hi);transition:border-color var(--trans),background var(--trans);}
    .card:hover:not(.matched):not(.flipped) .card-back{border-color:var(--accent2);background:#272a3f;}
    .card:active:not(.matched) .card-back{background:#2a2d44;}
    .card-back-inner{width:100%;height:100%;display:flex;align-items:center;justify-content:center;position:relative;}
    .card-back-pattern{position:absolute;inset:0;opacity:0.07;background-image:repeating-linear-gradient(45deg,var(--accent2) 0,var(--accent2) 1px,transparent 0,transparent 50%);background-size:10px 10px;border-radius:6px;}
    .card-back-logo{font-family:var(--font-d);font-size:0.55rem;font-weight:800;color:rgba(255,255,255,0.18);letter-spacing:0.06em;position:relative;}
    .card-front{transform:rotateY(180deg);flex-direction:column;gap:0.2rem;}
    .card-front.term{background:var(--term-bg);border:1.5px solid var(--term-edge);}
    .card-front.def{background:var(--def-bg);border:1.5px solid var(--def-edge);}
    .card-type-badge{font-family:var(--font-d);font-size:0.44rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;padding:0.08rem 0.3rem;border-radius:3px;flex-shrink:0;}
    .card-front.term .card-type-badge{background:var(--term-edge);color:#a8c0ff;}
    .card-front.def .card-type-badge{background:var(--def-edge);color:#a0e8c0;}
    .card-text{font-family:var(--font-d);font-weight:600;line-height:1.2;color:var(--text);}
    .card.matched .card-front{border-color:var(--correct)!important;background:rgba(74,222,154,0.08)!important;}
    .card.matched .card-text{color:var(--correct);}
    .card.matched .card-type-badge{opacity:0.5;}
    .card.wrong .card-inner{animation:wrongShake 0.45s ease;}
    @keyframes wrongShake{0%,100%{transform:rotateY(180deg)}20%{transform:rotateY(180deg) translateX(-5px)}60%{transform:rotateY(180deg) translateX(5px)}}
    .card.just-matched .card-inner{animation:correctPop 0.38s ease 0.42s both;}
    @keyframes correctPop{0%{transform:rotateY(180deg) scale(1)}50%{transform:rotateY(180deg) scale(1.06)}100%{transform:rotateY(180deg) scale(1)}}
    .card.locked{pointer-events:none;}
    .overlay{display:none;position:fixed;inset:0;background:rgba(8,10,18,0.9);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);z-index:500;align-items:center;justify-content:center;padding:1.5rem;}
    .overlay.open{display:flex;}
    .result-card{background:var(--surface);border:1px solid var(--border-hi);border-radius:18px;padding:2rem 2.5rem;max-width:440px;width:100%;text-align:center;animation:slideUp 0.38s cubic-bezier(0.34,1.56,0.64,1);position:relative;overflow:hidden;}
    .result-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--accent2),var(--accent));}
    @keyframes slideUp{from{opacity:0;transform:translateY(28px) scale(0.95)}to{opacity:1;transform:none}}
    .result-emoji{font-size:3rem;margin-bottom:0.6rem;display:block;}
    .result-heading{font-family:var(--font-d);font-size:1.8rem;font-weight:800;letter-spacing:-0.03em;margin-bottom:0.35rem;}
    .result-sub{color:var(--text-mid);font-size:0.875rem;margin-bottom:1.5rem;}
    .result-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:0.75rem;margin-bottom:1.75rem;}
    .result-stat{background:var(--surface2);border:1px solid var(--border-hi);border-radius:var(--r);padding:0.85rem 0.5rem;}
    .result-stat-val{font-family:var(--font-d);font-size:1.8rem;font-weight:800;line-height:1;margin-bottom:0.2rem;}
    .result-stat-val.good{color:var(--correct);}
    .result-stat-val.neutral{color:var(--accent2);}
    .result-stat-val.time{color:var(--accent);}
    .result-stat-label{font-size:0.65rem;color:var(--text-dim);letter-spacing:0.08em;text-transform:uppercase;}
    .btn-retry{font-family:var(--font-d);font-size:0.85rem;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;background:var(--accent);color:#0f1117;border:none;padding:0.85rem 2.5rem;border-radius:var(--r);cursor:pointer;transition:all var(--trans);width:100%;margin-bottom:0.65rem;}
    .btn-retry:hover{background:#6ef0b0;transform:translateY(-1px);box-shadow:0 4px 18px rgba(74,222,154,0.3);}
    .btn-retry:active{transform:translateY(0);box-shadow:none;}
    .btn-change{font-family:var(--font-d);font-size:0.75rem;font-weight:600;letter-spacing:0.05em;text-transform:uppercase;background:transparent;border:1px solid var(--border-hi);color:var(--text-mid);padding:0.6rem 2rem;border-radius:var(--r);cursor:pointer;transition:all var(--trans);width:100%;}
    .btn-change:hover{border-color:var(--accent2);color:var(--accent2);}

    /* ── Juice: deal-in, match glow, streak, particles ── */
    .card.deal{animation:dealIn 0.42s cubic-bezier(0.34,1.56,0.64,1) both;}
    @keyframes dealIn{from{opacity:0;transform:translateY(26px) scale(0.72);}to{opacity:1;transform:none;}}
    .card.just-matched .card-front{animation:matchGlow 0.9s ease 0.42s both;}
    @keyframes matchGlow{0%{box-shadow:0 0 0 rgba(74,222,154,0);}35%{box-shadow:0 0 18px rgba(74,222,154,0.6),0 0 4px rgba(74,222,154,0.8);}100%{box-shadow:0 0 0 rgba(74,222,154,0);}}
    .streak-pill{display:none;color:#ffd166;border-color:rgba(255,209,102,0.35);background:rgba(255,209,102,0.1);}
    .streak-pill.on{display:inline-block;animation:comboIn 0.18s ease;}
    @keyframes comboIn{from{transform:scale(0.6);opacity:0}to{transform:scale(1);opacity:1}}
    .combo-float{position:fixed;z-index:600;font-family:var(--font-d);font-weight:800;color:#ffd166;text-shadow:0 2px 10px rgba(0,0,0,0.65);pointer-events:none;white-space:nowrap;}
    .fx-bit{position:fixed;z-index:650;pointer-events:none;border-radius:2px;}

    @media (prefers-reduced-motion: reduce){
      .card-inner{transition-duration:0.01s!important;}
      .card.deal{animation:none!important;}
      .card.wrong .card-inner,.card.just-matched .card-inner{animation:none!important;}
      .card.just-matched .card-front{animation:none!important;}
      .progress-fill{transition:none!important;}
    }

    /* Responsive */
    @media(max-width:640px){
      .pill-acc,.timer-label{display:none;}
    }
    @media(max-width:400px){
      .hd{padding:0 0.85rem;}
      .hd-sep,.hd-title{display:none;}
      .difficulty-grid{grid-template-columns:repeat(2,1fr);}
    }
  </style>
<!-- aism-rebranded:v1 --></head>
