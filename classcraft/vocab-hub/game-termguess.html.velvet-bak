<!DOCTYPE html>

<html lang="en">
<head><link href="../../style.css" rel="stylesheet"/>
<script src="../../script.js" defer></script>

<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>TermGuess Vocabulary Game | Free Revision Quiz — AI Study Method</title>
<meta content="Play TermGuess — a free vocabulary revision game for all subjects. No login required. Learn key terms and definitions the fun way. Try it now." name="description"/>
<link rel="canonical" href="https://aistudymethod.co.uk/classcraft/vocab-hub/game-termguess.html">
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&amp;display=swap" rel="stylesheet"/>
<style>
    :root {
      --bg:#0f1117; --surface:#1a1d27; --surface2:#22253a;
      --border:rgba(255,255,255,0.08); --border-hi:rgba(255,255,255,0.14);
      --accent:#4ade9a; --accent2:#7b6fff; --warn:#ff6b6b; --gold:#ffd166;
      --text:#e8eaf0; --text-mid:#8b90a8; --text-dim:#4a4f68;
      --correct:#538d4e;   /* green  — right letter, right place  */
      --present:#b59f3b;   /* yellow — right letter, wrong place  */
      --absent:#3a3a3c;    /* dark   — letter not in word         */
      --font-d:'Nunito',sans-serif; --font-b:'Nunito',sans-serif;
      --r:10px; --trans:0.18s cubic-bezier(0.25,0.46,0.45,0.94);
    }
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
    html,body{height:100%;overflow:hidden;}
    body{background:var(--bg);color:var(--text);font-family:var(--font-b);font-size:15px;line-height:1.5;display:flex;flex-direction:column;height:100vh;height:100dvh;}

    /* ── Header ── */
    .hd{background:var(--surface);border-bottom:1px solid var(--border);padding:0 1.25rem;height:52px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0;gap:0.75rem;}
    .hd-left{display:flex;align-items:center;gap:0.85rem;min-width:0;}
    .hd-logo{font-family:var(--font-d);font-size:1.05rem;font-weight:800;color:var(--text);text-decoration:none;letter-spacing:-0.02em;flex-shrink:0;}
    .hd-logo span{color:var(--accent);}
    .hd-title{font-family:var(--font-d);font-size:0.8rem;font-weight:600;color:var(--text-mid);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0;}
    .hd-sep{color:var(--text-dim);flex-shrink:0;}
    .hd-right{display:flex;align-items:center;gap:0.5rem;flex-shrink:0;}
    .hd-stats{display:flex;align-items:center;gap:0.5rem;}
    .stat-pill{font-family:var(--font-d);font-size:0.75rem;font-weight:700;color:var(--text);background:var(--surface2);border:1px solid var(--border-hi);border-radius:var(--r);padding:0.22rem 0.6rem;white-space:nowrap;}
    .stat-pill span{color:var(--accent);}
    .stat-pill.streak-pill{color:var(--gold);border-color:rgba(255,209,102,0.4);background:rgba(255,209,102,0.08);}
    .stat-pill.streak-pill span{color:var(--gold);}
    .stat-pill.streak-pill.bump{animation:bumpIn 0.22s ease;}
    @keyframes bumpIn{from{transform:scale(0.6)}60%{transform:scale(1.18)}to{transform:scale(1)}}
    #score-display{display:inline-block;}
    #score-display.pop{animation:scorePop 0.28s ease;}
    @keyframes scorePop{0%{transform:scale(1)}50%{transform:scale(1.4)}100%{transform:scale(1)}}
    .btn-hd{font-family:var(--font-d);font-size:0.65rem;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;background:transparent;border:1px solid var(--border-hi);color:var(--text-mid);padding:0.22rem 0.75rem;border-radius:var(--r);cursor:pointer;transition:all var(--trans);white-space:nowrap;}
    .btn-hd:hover{border-color:var(--accent);color:var(--accent);}
    .btn-hd:active{transform:scale(0.96);}
    .progress-bar{height:3px;background:var(--surface2);flex-shrink:0;}
    .progress-fill{height:100%;background:linear-gradient(90deg,var(--accent2),var(--accent));width:0%;transition:width 0.4s ease;box-shadow:0 0 6px rgba(74,222,154,0.5);}

    /* ── Screens ── */
    .screen{flex:1;display:none;flex-direction:column;align-items:center;justify-content:center;padding:1.5rem;overflow-y:auto;min-height:0;}
    .screen.active{display:flex;}

    /* ── Start screen ── */
    .start-title{font-family:var(--font-d);font-size:clamp(1.4rem,3vw,1.8rem);font-weight:800;letter-spacing:-0.03em;margin-bottom:0.25rem;text-align:center;}
    .start-topic{font-family:var(--font-d);font-size:0.78rem;font-weight:600;color:var(--accent2);text-align:center;margin-bottom:1rem;letter-spacing:0.05em;}
    .start-sub{color:var(--text-mid);font-size:0.85rem;margin-bottom:1.5rem;text-align:center;max-width:44ch;}
    .legend{display:flex;gap:1.5rem;margin-bottom:1.5rem;flex-wrap:wrap;justify-content:center;}
    .legend-item{display:flex;align-items:center;gap:0.5rem;font-size:0.8rem;color:var(--text-mid);}
    .legend-tile{width:28px;height:28px;border-radius:4px;display:flex;align-items:center;justify-content:center;font-family:var(--font-d);font-size:0.75rem;font-weight:800;color:#fff;}
    .legend-tile.c{background:var(--correct);}
    .legend-tile.p{background:var(--present);}
    .legend-tile.a{background:var(--absent);}
    .start-info{background:var(--surface);border:1px solid var(--border-hi);border-radius:var(--r);padding:1rem 1.25rem;margin-bottom:1.5rem;max-width:400px;width:100%;}
    .start-info-row{display:flex;align-items:center;gap:0.75rem;font-size:0.82rem;color:var(--text-mid);}
    .start-info-row+.start-info-row{margin-top:0.5rem;}
    .start-info-icon{font-size:1.1rem;flex-shrink:0;}
    .btn-start{font-family:var(--font-d);font-size:0.85rem;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;background:var(--accent);color:#0f1117;border:none;padding:0.85rem 2.5rem;border-radius:var(--r);cursor:pointer;transition:all var(--trans);}
    .btn-start:hover{background:#6ef0b0;transform:translateY(-1px);box-shadow:0 4px 20px rgba(74,222,154,0.35);}
    .btn-start:active{transform:translateY(0);box-shadow:none;}

    /* ── Game screen ── */
    #screen-game{
      padding:0.75rem 1rem;
      gap:0;
      justify-content:space-between;
      overflow:hidden;
    }
    /* Clue at top */
    .clue-wrap{width:100%;max-width:640px;flex-shrink:0;margin-bottom:0.5rem;}
    /* Grid centred in remaining space */
    .grid-wrap{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0.25rem;min-height:0;}
    .grid-wrap.round-in{animation:roundIn 0.35s ease;}
    @keyframes roundIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
    .clue-wrap.round-in{animation:roundIn 0.35s ease;}
    /* Submit + keyboard pinned to bottom */
    .kb-submit-wrap{
      flex-shrink:0;
      display:flex;
      flex-direction:column;
      gap:0.4rem;
      width:100%;
      max-width:500px;
      padding-bottom:0.25rem;
    }

    /* Clue internals */
    .clue-wrap-inner{width:100%;max-width:640px;}
    .clue-label{font-family:var(--font-d);font-size:0.62rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--text-dim);margin-bottom:0.35rem;}
    .clue-box{background:var(--surface);border:1.5px solid var(--border-hi);border-radius:var(--r);padding:0.85rem 1.1rem;font-family:var(--font-d);font-size:clamp(0.85rem,1.5vw,1.05rem);font-weight:600;color:var(--text);line-height:1.4;}
    .round-badge{font-family:var(--font-d);font-size:0.65rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--text-mid);margin-top:0.35rem;}

    /* ── TermGuess grid ── */
    /* grid-wrap layout handled by #screen-game rules above */

    /* One guess row = a flex row of letter tiles + optional space tiles */
    .guess-row{display:flex;gap:0.3rem;align-items:center;}

    /* Letter tile */
    .wl-tile{
      width:40px;height:40px;
      border:2px solid var(--border-hi);
      border-radius:5px;
      display:flex;align-items:center;justify-content:center;
      font-family:var(--font-d);font-size:1.1rem;font-weight:800;
      color:var(--text);
      background:transparent;
      transition:border-color 0.05s;
      position:relative;
    }
    .wl-tile.active-row{border-color:rgba(255,255,255,0.3);}
    .wl-tile.filled{border-color:rgba(255,255,255,0.5);}
    /* Fixed tile — non-letter characters (hyphens etc.) given for free */
    .wl-tile.fixed{border-color:var(--border);background:var(--surface2);color:var(--text-dim);}

    /* Flip animation for reveal */
    .wl-tile.flip{animation:flip 0.5s ease forwards;}
    @keyframes flip{
      0%  {transform:rotateX(0);   background:transparent;}
      49% {transform:rotateX(90deg);background:transparent;}
      50% {transform:rotateX(90deg);}
      100%{transform:rotateX(0);}
    }

    /* State colours applied after flip */
    .wl-tile.correct{background:var(--correct);border-color:var(--correct);color:#fff;}
    .wl-tile.present{background:var(--present);border-color:var(--present);color:#fff;}
    .wl-tile.absent {background:var(--absent); border-color:var(--absent); color:#fff;}

    /* Winning-row dance */
    .wl-tile.dance{animation:dance 0.55s ease both;}
    @keyframes dance{0%,100%{transform:translateY(0)}40%{transform:translateY(-14px)}70%{transform:translateY(2px)}}

    /* Space tile — just a narrow gap indicator */
    .wl-space{
      width:10px;height:40px;
      display:flex;align-items:center;justify-content:center;
      flex-shrink:0;
    }
    .wl-space-dot{width:4px;height:4px;border-radius:50%;background:var(--text-dim);}

    /* Bounce on entry */
    @keyframes bounce{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
    .wl-tile.bounce{animation:bounce 0.15s ease;}

    /* Shake on invalid */
    @keyframes shake{0%,100%{transform:translateX(0)}20%{transform:translateX(-5px)}60%{transform:translateX(5px)}}
    .shake-row{animation:shake 0.3s ease;}

    /* ── Submit button ── */
    .btn-submit-guess{
      font-family:var(--font-d);font-size:0.82rem;font-weight:700;
      letter-spacing:0.06em;text-transform:uppercase;
      background:var(--accent2);color:#fff;border:none;
      padding:0.6rem 2rem;border-radius:var(--r);
      cursor:pointer;transition:all var(--trans);
      width:100%;
    }
    .btn-submit-guess:hover{background:#9a8fff;transform:translateY(-1px);box-shadow:0 4px 16px rgba(123,111,255,0.3);}
    .btn-submit-guess:active{transform:translateY(0);box-shadow:none;}

    /* ── Keyboard ── */
    .keyboard{flex-shrink:0;width:100%;max-width:500px;}
    .kb-row{display:flex;justify-content:center;gap:0.3rem;margin-bottom:0.3rem;}
    .kb-key{
      font-family:var(--font-d);font-size:0.78rem;font-weight:700;
      background:var(--surface2);border:1px solid var(--border-hi);
      border-radius:5px;padding:0.55rem 0;min-width:34px;
      cursor:pointer;color:var(--text);transition:all var(--trans);
      text-align:center;user-select:none;-webkit-user-select:none;flex:1;max-width:40px;
      -webkit-tap-highlight-color:transparent;
    }
    .kb-key.wide{min-width:52px;max-width:60px;font-size:0.65rem;}
    .kb-key:hover:not(.revealed){filter:brightness(1.3);transform:translateY(-1px);}
    .kb-key:active{transform:scale(0.92);}
    .kb-key.pressed{animation:keyPress 0.14s ease;}
    @keyframes keyPress{50%{transform:scale(0.88);filter:brightness(1.6)}}
    .kb-key.correct{background:var(--correct);border-color:var(--correct);color:#fff;}
    .kb-key.present{background:var(--present);border-color:var(--present);color:#fff;}
    .kb-key.absent {background:var(--absent); border-color:var(--absent); color:rgba(255,255,255,0.4);}
    .kb-key.revealed{pointer-events:none;}

    /* Toast message */
    .toast{
      position:fixed;top:64px;left:50%;transform:translateX(-50%);
      background:var(--text);color:var(--bg);
      font-family:var(--font-d);font-size:0.82rem;font-weight:700;
      padding:0.5rem 1.25rem;border-radius:6px;
      opacity:0;pointer-events:none;
      transition:opacity 0.15s;
      z-index:400;white-space:nowrap;
    }
    .toast.show{opacity:1;}

    /* Floating +points */
    .float-pts{
      position:fixed;transform:translateX(-50%);
      font-family:var(--font-d);font-size:1.25rem;font-weight:800;
      color:var(--accent);z-index:600;pointer-events:none;
      text-shadow:0 2px 14px rgba(74,222,154,0.55);
      animation:floatUp 1s ease forwards;
    }
    @keyframes floatUp{from{opacity:1}to{opacity:0;transform:translateX(-50%) translateY(-64px)}}

    /* Confetti */
    .confetti-wrap{position:fixed;inset:0;pointer-events:none;z-index:650;overflow:hidden;}
    .confetti{position:absolute;top:-14px;width:8px;height:8px;animation:confFall linear forwards;}
    @keyframes confFall{to{transform:translate(var(--cx,0),105vh) rotate(var(--cr,360deg));opacity:0.85;}}

    /* ── Result overlays ── */
    .overlay{display:none;position:fixed;inset:0;background:rgba(8,10,18,0.9);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);z-index:500;align-items:center;justify-content:center;padding:1.5rem;}
    .overlay.open{display:flex;}
    .result-card{background:var(--surface);border:1px solid var(--border-hi);border-radius:18px;padding:2rem 2.5rem;max-width:440px;width:100%;text-align:center;animation:slideUp 0.38s cubic-bezier(0.34,1.56,0.64,1);display:flex;flex-direction:column;gap:1rem;position:relative;overflow:hidden;}
    .result-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--accent2),var(--accent));}
    @keyframes slideUp{from{opacity:0;transform:translateY(28px) scale(0.95)}to{opacity:1;transform:none}}
    .result-emoji{font-size:3rem;display:block;}
    .result-heading{font-family:var(--font-d);font-size:1.5rem;font-weight:800;letter-spacing:-0.02em;}
    .result-word{display:flex;flex-wrap:wrap;justify-content:center;gap:2px;}
    .mini-tile{display:inline-flex;width:27px;height:27px;align-items:center;justify-content:center;background:var(--correct);border-radius:4px;color:#fff;font-family:var(--font-d);font-weight:800;font-size:0.85rem;animation:miniPop 0.3s cubic-bezier(0.34,1.56,0.64,1) both;}
    .mini-tile.dim{background:var(--surface2);color:var(--text-mid);}
    .mini-space{display:inline-block;width:10px;}
    @keyframes miniPop{from{transform:scale(0);opacity:0}to{transform:scale(1);opacity:1}}
    .result-def{font-size:0.82rem;color:var(--text-mid);line-height:1.5;}
    .result-tries{font-family:var(--font-d);font-size:0.78rem;color:var(--text-mid);}
    .result-tries span{color:var(--accent);}
    .result-sub{color:var(--text-mid);font-size:0.8rem;line-height:1.5;}
    .result-btns{display:flex;gap:0.65rem;}
    .btn-next{font-family:var(--font-d);font-size:0.82rem;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;background:var(--accent);color:#0f1117;border:none;padding:0.75rem 1.5rem;border-radius:var(--r);cursor:pointer;transition:all var(--trans);flex:1;}
    .btn-next:hover{background:#6ef0b0;transform:translateY(-1px);box-shadow:0 4px 18px rgba(74,222,154,0.3);}
    .btn-next:active{transform:translateY(0);box-shadow:none;}
    .btn-end{font-family:var(--font-d);font-size:0.75rem;font-weight:600;letter-spacing:0.05em;text-transform:uppercase;background:transparent;border:1px solid var(--border-hi);color:var(--text-mid);padding:0.65rem 1rem;border-radius:var(--r);cursor:pointer;transition:all var(--trans);flex:1;}
    .btn-end:hover{border-color:var(--accent2);color:var(--accent2);}
    .final-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:0.55rem;}
    @media(max-width:420px){.final-stats{grid-template-columns:repeat(2,1fr);}}
    .final-stat{background:var(--surface2);border:1px solid var(--border-hi);border-radius:var(--r);padding:0.75rem 0.4rem;}
    .final-stat-val{font-family:var(--font-d);font-size:1.5rem;font-weight:800;line-height:1;margin-bottom:0.2rem;}
    .final-stat-val.good{color:var(--accent);}
    .final-stat-val.bad{color:var(--warn);}
    .final-stat-val.neutral{color:var(--accent2);}
    .final-stat-val.hot{color:var(--gold);}
    .final-stat-label{font-size:0.62rem;color:var(--text-dim);letter-spacing:0.08em;text-transform:uppercase;}
    .btn-hub{font-family:var(--font-d);font-size:0.82rem;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;background:var(--accent);color:#0f1117;border:none;padding:0.75rem 1.5rem;border-radius:var(--r);cursor:pointer;transition:all var(--trans);width:100%;}
    .btn-hub:hover{background:#6ef0b0;transform:translateY(-1px);box-shadow:0 4px 18px rgba(74,222,154,0.3);}
    .btn-hub:active{transform:translateY(0);box-shadow:none;}
    .btn-play-again{font-family:var(--font-d);font-size:0.75rem;font-weight:600;letter-spacing:0.05em;text-transform:uppercase;background:transparent;border:1px solid var(--border-hi);color:var(--text-mid);padding:0.65rem 1rem;border-radius:var(--r);cursor:pointer;transition:all var(--trans);width:100%;}
    .btn-play-again:hover{border-color:var(--accent2);color:var(--accent2);}

    /* Reduced motion: keep the game readable, drop the theatrics */
    @media(prefers-reduced-motion:reduce){
      .wl-tile.flip,.wl-tile.bounce,.wl-tile.dance,.shake-row,
      .grid-wrap.round-in,.clue-wrap.round-in,.kb-key.pressed,
      .mini-tile,.stat-pill.streak-pill.bump,#score-display.pop{animation:none!important;}
      .float-pts{animation:floatFade 1s ease forwards;}
      .progress-fill{transition:none;}
      .result-card{animation:none;}
    }
    @keyframes floatFade{from{opacity:1}to{opacity:0}}

    /* Responsive */
    @media(max-width:400px){
      .hd{padding:0 0.85rem;}
      .hd-sep,.hd-title{display:none;}
    }
  </style>
<!-- aism-rebranded:v1 --></head>
<body><nav>
