    <!-- 0 WELCOME -->
    <section class="screen active">
      <span class="tag">Mini-Lesson</span>
      <h1>Matter</h1>
      <p class="big">This mini-lesson walks you through the whole of <b>OCR Gateway P1 — Matter</b>: the <b>particle model</b>, <b>density</b>, <b>changes of state</b>, <b>specific heat capacity</b> and <b>latent heat</b>, <b>gas pressure</b>, and the <b>structure of the atom</b> and how that model was built.</p>
      <figure>
        <svg viewBox="0 0 560 160" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Solid, liquid and gas particle arrangements">
          <rect x="18" y="30" width="150" height="100" rx="14" fill="#d9ebff" stroke="#2c2840" stroke-width="3"/>
