          <g fill="#c8203a"><circle cx="420" cy="55" r="8"/><circle cx="500" cy="48" r="8"/><circle cx="455" cy="80" r="8"/><circle cx="520" cy="90" r="8"/><circle cx="430" cy="112" r="8"/><circle cx="490" cy="118" r="8"/></g>
