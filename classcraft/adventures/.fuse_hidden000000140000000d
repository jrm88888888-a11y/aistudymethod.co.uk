          <g fill="#9a5a00"><circle cx="240" cy="55" r="8"/><circle cx="268" cy="70" r="8"/><circle cx="300" cy="58" r="8"/><circle cx="330" cy="72" r="8"/><circle cx="250" cy="92" r="8"/><circle cx="285" cy="95" r="8"/><circle cx="318" cy="100" r="8"/><circle cx="240" cy="118" r="8"/><circle cx="300" cy="120" r="8"/></g>
          <text x="280" y="24" text-anchor="middle" font-family="Fredoka" font-size="14" font-weight="600" fill="#9a5a00">liquid</text>
