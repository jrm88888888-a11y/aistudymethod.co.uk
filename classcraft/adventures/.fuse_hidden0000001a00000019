          <circle cx="130" cy="175" r="34" fill="#efe1ff" stroke="#2c2840" stroke-width="3"/>
          <text x="130" y="180" text-anchor="middle" font-family="Fredoka" font-size="13" font-weight="600" fill="#6a30b8">Son</text>
          <circle cx="430" cy="175" r="34" fill="#efe1ff" stroke="#2c2840" stroke-width="3"/>
          <text x="430" y="172" text-anchor="middle" font-family="Fredoka" font-size="12" font-weight="600" fill="#6a30b8">Holy</text>
          <text x="430" y="187" text-anchor="middle" font-family="Fredoka" font-size="12" font-weight="600" fill="#6a30b8">Spirit</text>
          <circle cx="280" cy="133" r="30" fill="#fff1c2" stroke="#2c2840" stroke-width="3"/>
