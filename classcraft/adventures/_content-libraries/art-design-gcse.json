          "term": "Two-point perspective",
          "def": "Two vanishing points on the horizon; suits corner views of buildings."
        },
        {
          "term": "Vanishing point",
          "def": "Point on horizon where parallel lines appear to meet."
        },
        {
          "term": "Atmospheric perspective",
          "def": "Distant objects appear paler, bluer and less detailed - depth via colour and contrast."
        },
        {
          "term": "Foreshortening",
          "def": "Drawing object dimensions shorter than they actually are to indicate depth (e.g., a pointing finger)."
