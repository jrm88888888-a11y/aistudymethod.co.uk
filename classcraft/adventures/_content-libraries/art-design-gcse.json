    "colour-theory": {
      "topic_display": "Colour Theory",
      "concepts": [
        {
          "term": "Primary colours",
          "def": "Red, yellow, blue (pigment); cannot be made by mixing other colours."
        },
        {
          "term": "Secondary colours",
          "def": "Orange, green, purple; made by mixing two primaries."
        },
        {
          "term": "Tertiary colours",
          "def": "Made by mixing a primary with a neighbouring secondary (e.g., yellow-orange)."
        },
        {
          "term": "Complementary colours",
          "def": "Opposite on the colour wheel; create vibrant contrast (red/green)."
        },
        {
          "term": "Analogous colours",
          "def": "Adjacent on the wheel; create harmony (blue/blue-green/green)."
        },
        {
