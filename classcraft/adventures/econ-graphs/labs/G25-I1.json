{"id":"G25-I1","variant":"*","board":"*","template":"T13","screen":"N.5","title":"Watch your savings grow","currency":"","model":{"vars":[["int1","5000*r/100"],["bal","5000*(1+r/100)^yrs"]]},"controls":[{"id":"r","type":"range","label":"Interest rate","min":0,"max":10,"start":3,"step":0.5,"fmt":"{fmt(v,1)}%"},{"id":"yrs","type":"range","label":"Years","min":1,"max":10,"start":1,"step":1}],"panels":[{"type":"xy","x":{"label":"Years","min":0.3,"max":10.7,"ticks":[{"v":1,"l":"1"},{"v":2,"l":"2"},{"v":3,"l":"3"},{"v":4,"l":"4"},{"v":5,"l":"5"},{"v":6,"l":"6"},{"v":7,"l":"7"},{"v":8,"l":"8"},{"v":9,"l":"9"},{"v":10,"l":"10"}]},"y":{"label":"Balance","min":0,"max":18000,"ticks":[0,5000,10000,15000]},"els":[{"t":"rect","x0":0.62,"y0":0,"x1":1.38,"y1":"5000*(1+r/100)^1","k":"green","op":0.75,"if":"yrs>=1"},{"t":"rect","x0":1.62,"y0":0,"x1":2.38,"y1":"5000*(1+r/100)^2","k":"green","op":0.75,"if":"yrs>=2"},{"t":"rect","x0":2.62,"y0":0,"x1":3.38,"y1":"5000*(1+r/100)^3","k":"green","op":0.75,"if":"yrs>=3"},{"t":"rect","x0":3.62,"y0":0,"x1":4.38,"y1":"5000*(1+r/100)^4","k":"green","op":0.75,"if":"yrs>=4"},{"t":"rect","x0":4.62,"y0":0,"x1":5.38,"y1":"5000*(1+r/100)^5","k":"green","op":0.75,"if":"yrs>=5"},{"t":"rect","x0":5.62,"y0":0,"x1":6.38,"y1":"5000*(1+r/100)^6","k":"green","op":0.75,"if":"yrs>=6"},{"t":"rect","x0":6.62,"y0":0,"x1":7.38,"y1":"5000*(1+r/100)^7","k":"green","op":0.75,"if":"yrs>=7"},{"t":"rect","x0":7.62,"y0":0,"x1":8.38,"y1":"5000*(1+r/100)^8","k":"green","op":0.75,"if":"yrs>=8"},{"t":"rect","x0":8.62,"y0":0,"x1":9.38,"y1":"5000*(1+r/100)^9","k":"green","op":0.75,"if":"yrs>=9"},{"t":"rect","x0":9.62,"y0":0,"x1":10.38,"y1":"5000*(1+r/100)^10","k":"green","op":0.75,"if":"yrs>=10"},{"t":"hline","y":5000,"k":"grey","lab":"saved 5,000","dash":"4 4"}],"h":230,"ml":56}],"readouts":[{"l":"Interest in the first year","v":"{fmt(int1,2)}","k":"blue"},{"l":"Balance after {yrs} year{yrs==1 ? \"\" : \"s\"}","v":"{fmt(bal,2)}","k":"green"}],"predict":{"q":"You save **5,000**.