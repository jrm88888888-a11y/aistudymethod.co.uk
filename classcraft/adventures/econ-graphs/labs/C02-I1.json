{"id":"C02-I1","variant":"*","board":"*","template":"T07","screen":"N.7","title":"Which curves move?","currency":"","model":{"tables":{"T":[60,100,130,180,260,380],"M":[60,40,30,50,80,120]},"vars":[["k","1+w/100"],["ATC1","(rent+60*k)/1"],["AVC1","60*k/1"],["MC1","60*k"],["ATC2","(rent+100*k)/2"],["AVC2","100*k/2"],["MC2","40*k"],["ATC3","(rent+130*k)/3"],["AVC3","130*k/3"],["MC3","30*k"],["ATC4","(rent+180*k)/4"],["AVC4","180*k/4"],["MC4","50*k"],["ATC5","(rent+260*k)/5"],["AVC5","260*k/5"],["MC5","80*k"],["ATC6","(rent+380*k)/6"],["AVC6","380*k/6"],["MC6","120*k"],["minq","argmin6(ATC1,ATC2,ATC3,ATC4,ATC5,ATC6)"]],"funcs":{"argmin6":["a,b,c,d,e,f","a<=min(b,c,d,e,f) ? 1 : (b<=min(c,d,e,f) ? 2 : (c<=min(d,e,f) ? 3 : (d<=min(e,f) ? 4 : (e<=f ? 5 : 6))))"]}},"controls":[{"id":"rent","type":"range","label":"Rent (fixed cost)","min":50,"max":200,"start":100,"step":25},{"id":"w","type":"range","label":"Wage change","min":-20,"max":40,"start":0,"step":10,"fmt":"{spct(v)}"}],"panels":[{"type":"xy","x":{"label":"Output (batches)","min":0.5,"max":6.5,"ticks":[1,2,3,4,5,6]},"y":{"label":"Costs","min":0,"max":280,"ticks":[0,100,200]},"els":[{"t":"curve","px":"t","py":"lerp(M,t-1)","k":"grey","lab":"","from":1,"to":6,"n":60,"dash":true,"if":"w!=0"},{"t":"curve","px":"t","py":"(100+lerp(T,t-1))/t","k":"grey","lab":"","from":1,"to":6,"n":60,"dash":true,"if":"rent!=100 || w!=0"},{"t":"curve","px":"t","py":"lerp(M,t-1)*k","k":"s","lab":"MC","from":1,"to":6,"n":60},{"t":"curve","px":"t","py":"rent/t","k":"grey","lab":"AFC","from":1,"to":6,"n":60,"lp":"start","dy":-4},{"t":"curve","px":"t","py":"lerp(T,t-1)*k/t","k":"green","lab":"AVC","from":1,"to":6,"n":60},{"t":"curve","px":"t","py":"(rent+lerp(T,t-1)*k)/t","k":"purple","lab":"ATC","from":1,"to":6,"n":60},{"t":"pt","x":"minq","y":"(rent+T[minq-1]*k)/minq","k":"purple","r":4.5}],"h":280}],"readouts":[{"l":"ATC at 1–6 batches","v":"{fmt(ATC1,0)}, {fmt(ATC2,0)}, {fmt(ATC3,1)}, {fmt(ATC4,1)}, {fmt(ATC5,1)}, {fmt(ATC6,1)}","k":"purple","wide":true},{"l":"MC at 1–6 batches","v":"{fmt(MC1,0)}, {fmt(MC2,0)}, {fmt(MC3,0)}, {fmt(MC4,0)}, {fmt(MC5,0)}, {fmt(MC6,0)}","k":"orange","wide":true},{"l":"Lowest ATC at","v":"{minq} batches"}],"predict":{"q":"The bakery's rent doubles, so fixed cost rises from 100 to 200. Which curves shift?","options":[{"k":"A","s":"MC, AFC, AVC and ATC all shift up","fb":"Rent does not change with output, so it adds nothing to the cost of the next batch. MC and AVC stay put."},{"k":"B","s":"AFC and ATC shift up; AVC and MC do not move","fb":"Only the fixed cost changed: AFC and ATC rise (ATC now 260, 150, 110, 95, 92, 96.67) and the lowest ATC moves from 4 to 5 batches."},{"k":"C","s":"Only MC shifts up","fb":"MC moves only when the cost of extra output changes. Rent is the same at every output."},{"k":"D","s":"None: rent was already being paid","fb":"Paying more rent raises the fixed cost spread over each batch, so AFC and ATC rise."}],"correct":"B"},"task":"Move the rent slider, then the wage slider, and watch which curves move.","target":{"expr":"rent==200 && w==0","do":"Move the rent slider from 100 to 200, then press Check."},"takeaway":"Fixed costs move AFC and ATC only. Wages and other variable costs move AVC, ATC and MC.","alt":"Which curves move?","test":{"set":{"rent":200},"expect":["near(ATC1,260)","near(ATC2,150)","near(ATC3,110)","near(ATC4,95)","near(ATC5,92)","near(ATC6,96.667,0.001)","minq==5","before.minq==4","MC1==before.MC1","AVC4==before.AVC4"],"cases":[{"set":{"w":20},"expect":["near(MC1,72)","near(MC4,60)","near(AVC5,62.4)","near(ATC3,85.333,0.001)","near(ATC4,79)"]}]}}