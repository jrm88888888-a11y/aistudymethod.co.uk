{"id":"G20-I1","variant":"*","board":"*","template":"T09","screen":"N.10","title":"Set the minimum wage","currency":"£","model":{"funcs":{"Ld":["w","pick(dm,800-25*w,1100-50*w,1700-100*w)"],"Ls":["w","50*w-100"]},"vars":[["bind","mw>12"],["wage","max(mw,12)"],["emp","bind ? Ld(mw) : 500"],["want","bind ? Ls(mw) : 500"],["unemp","want-emp"]]},"controls":[{"id":"mw","type":"range","label":"Minimum wage","min":10,"max":16,"start":11,"step":0.5,"fmt":"{money(v)}"},{"id":"dm","type":"seg","label":"Demand for labour","options":[{"v":0,"l":"inelastic"},{"v":1,"l":"middle"},{"v":2,"l":"elastic"}],"start":1}],"panels":[{"type":"xy","x":{"label":"Number of workers","min":0,"max":1000,"ticks":false},"y":{"label":"Wage (£ per hour)","min":0,"max":20,"ticks":false},"els":[{"t":"fn","x":"Ld(y)","k":"d","lab":"D","if":"true"},{"t":"fn","x":"Ls(y)","k":"s","lab":"S","if":"true"},{"t":"hline","y":"mw","k":"red","lab":"{_pred && !bind ? \"minimum wage (not binding)\" : \"minimum wage\"}","dash":"6 4","if":"true"},{"t":"dim","x1":"emp","y1":"mw","x2":"want","y2":"mw","k":"purple","lab":"unemployed {fmt(unemp,0)}","dy":16,"anchor":"middle","if":"(true) && bind && unemp>0"},{"t":"drop","x":"emp","y":"wage","xl":"{fmt(emp,0)}","yl":"{money(wage,2)}","show":"predicted","if":"true"}],"h":270}],"readouts":[{"l":"Minimum wage","v":"{money(mw)}","k":"red","if":"true"},{"l":"Wage paid","v":"{money(wage)}","k":"red","show":"predicted","if":"true"},{"l":"Employed","v":"{fmt(emp,0)}","k":"blue","show":"predicted","if":"true"},{"l":"Want work","v":"{fmt(want,0)}","k":"orange","show":"predicted","if":"true"},{"l":"Unemployed","v":"{fmt(unemp,0)}","k":"purple","show":"predicted","if":"true"},{"l":"Floor","v":"{bind ? \"binding\" : \"not binding\"}","show":"predicted","if":"true"}],"predict":{"q":"In the market on the earlier screen (We = £12), the government sets a minimum wage of £11. What happens?","options":[{"k":"A","s":"Unemployment rises","fb":"Firms already pay £12, above the floor, so nobody's pay or job changes."},{"k":"B","s":"Nothing changes","fb":"The floor of £11 is below the market wage of £12, so it does not bind: the wage stays £12 and 500 people work."},{"k":"C","s":"The wage falls to £11","fb":"A minimum wage stops pay going below £11; it does not push the market wage down to it."}],"correct":"B"},"task":"Raise the minimum wage slider from £11 to £16 and watch employment and unemployment. Then switch demand for labour between \"inelastic\" and \"elastic\" at the same minimum wage.","target":{"expr":"mw>11","do":"Raise the minimum wage slider, then press Check."},"takeaway":"A floor below We does nothing; above We, fewer jobs, and more so when demand for labour is elastic.","alt":"Set the minimum wage","test":{"set":{"mw":14},"expect":["!before.bind","before.unemp==0","near(before.wage,12)","near(emp,400)","near(unemp,200)"],"cases":[{"set":{"mw":14,"dm":0},"expect":["near(emp,450)","near(unemp,150)"]},{"set":{"mw":14,"dm":2},"expect":["near(emp,300)","near(unemp,300)"]},{"set":{"mw":13},"expect":["near(emp,450)","near(unemp,100)"]}],"atStart":true,"inv":["R5=='' || (bind ? (has(R5,'binding') && !has(R5,'not') && unemp>0) : (has(R5,'not binding') && unemp==0))","!has(SVG,'not binding') || !bind"]}}