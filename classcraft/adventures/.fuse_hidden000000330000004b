        <p><b>Modals + infinitive:</b> <span class="es">poder</span> (puedo), <span class="es">querer</span> (quiero), <span class="es">deber</span> (debo), <span class="es">tener que</span>, <span class="es">hay que</span>, <span class="es">saber</span> + inf.</p>
