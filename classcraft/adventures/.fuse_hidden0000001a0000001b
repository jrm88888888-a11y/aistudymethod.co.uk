        </table>
        <table class="conj" aria-label="poder o to ue">
          <caption>o → ue · <span class="es">poder</span></caption>
          <tr><td>p<span class="chg">ue</span>do</td></tr><tr><td>p<span class="chg">ue</span>des</td></tr><tr><td>p<span class="chg">ue</span>de</td></tr>
          <tr><td style="color:var(--soft)">podemos</td></tr><tr><td style="color:var(--soft)">podéis</td></tr><tr><td>p<span class="chg">ue</span>den</td></tr>
        </table>
        <table class="conj" aria-label="pedir e to i">
          <caption>e → i · <span class="es">pedir</span></caption>
          <tr><td>p<span class="chg">i</span>do</td></tr><tr><td>p<span class="chg">i</span>des</td></tr><tr><td>p<span class="chg">i</span>de</td></tr>
