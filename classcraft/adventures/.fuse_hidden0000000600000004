          <!-- greenhouse gas layer -->
          <rect x="40" y="86" width="480" height="34" rx="14" fill="#ffe9c7" stroke="#2c2840" stroke-width="2.5" stroke-dasharray="7 5" opacity="0.85"/>
          <text x="280" y="108" text-anchor="middle" font-family="Fredoka" font-size="12.5" font-weight="600" fill="#9a5a00">greenhouse gases: CO₂ · methane · water vapour</text>
          <!-- outgoing IR from earth -->
          <line x1="330" y1="176" x2="400" y2="120" stroke="#ff5b6e" stroke-width="4"/><polygon points="400,120 386,124 392,134" fill="#ff5b6e"/>
          <text x="412" y="150" font-family="Nunito" font-size="11.5" fill="#c8203a">infrared out</text>
          <!-- re-radiated back down -->
          <line x1="400" y1="118" x2="340" y2="176" stroke="#ff5b6e" stroke-width="4" stroke-dasharray="6 5"/><polygon points="340,176 348,164 356,172" fill="#ff5b6e"/>
