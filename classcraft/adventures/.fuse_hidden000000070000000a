          <rect x="455" y="45" width="95" height="50" rx="12" fill="#d6f6e4" stroke="#2c2840" stroke-width="3"/>
          <text x="502" y="68" text-anchor="middle" font-family="Fredoka" font-size="12.5" font-weight="600" fill="#137a45">Strong</text>
          <text x="502" y="84" text-anchor="middle" font-family="Fredoka" font-size="12.5" font-weight="600" fill="#137a45">close</text>
          <line x1="140" y1="70" x2="163" y2="70" stroke="#2c2840" stroke-width="3"/><polygon points="165,70 153,64 153,76" fill="#2c2840"/>
          <line x1="285" y1="70" x2="308" y2="70" stroke="#2c2840" stroke-width="3"/><polygon points="310,70 298,64 298,76" fill="#2c2840"/>
          <line x1="430" y1="70" x2="453" y2="70" stroke="#2c2840" stroke-width="3"/><polygon points="455,70 443,64 443,76" fill="#2c2840"/>
          <text x="280" y="122" text-anchor="middle" font-family="Nunito" font-size="12.5" fill="#6b6580">Signpost each stage so the audience can follow you.</text>
        </svg>
        <figcaption>Signposting ("Firstly…", "My final point…") guides listeners who can't re-read what you said.</figcaption>
