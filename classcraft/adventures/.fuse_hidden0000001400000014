function setupText(tkey){const box=document.querySelector(`.textans[data-t="${tkey}"]`);if(!box)return;const ta=box.querySelector('textarea');const btn=box.querySelector('.checkbtn');const model=document.getElementById('model-'+tkey);const fb=document.getElementById('fb-'+tkey);btn.addEventListener('click',()=>{if(done[tkey])return;if((ta.value||'').trim().length<8){fb.textContent='Have a go first — write a sentence, then reveal the model ✍️';fb.className='feedback';return;}model.classList.add('show');btn.disabled=true;ta.readOnly=true;fb.innerHTML='🌟 Nice effort! +1 star — compare yours with the model above.';fb.className='feedback good';addScore(1);done[tkey]=true;refreshGate();});}
['t1','t2'].forEach(setupText);

// match game 1: text ↔ religion
const matchPairs=[
  {l:'Qur’an',r:'Islam'},
  {l:'Guru Granth Sahib',r:'Sikhism'},
  {l:'Tipitaka',r:'Buddhism'},
  {l:'Torah / Tenakh',r:'Judaism'},
  {l:'The Bible',r:'Christianity'},
  {l:'Vedas &amp; Bhagavad Gita',r:'Hinduism'}
];
(function(){const wrap=document.getElementById('matchGame');if(!wrap)return;const fb=document.getElementById('fb-match');
  function shuffle(a){a=a.slice();for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;}
  const lefts=matchPairs.map((p,i)=>({t:p.l,k:i}));const rights=shuffle(matchPairs.map((p,i)=>({t:p.r,k:i})));
  let html='<div class="match"><div class="mcol"><div class="mhead">Sacred text</div>';
  lefts.forEach(o=>{html+='<div class="mitem" data-side="l" data-k="'+o.k+'">'+o.t+'</div>';});
  html+='</div><div class="mcol"><div class="mhead">Religion</div>';
  rights.forEach(o=>{html+='<div class="mitem" data-side="r" data-k="'+o.k+'">'+o.t+'</div>';});
  html+='</div></div>';wrap.innerHTML=html;
  let selL=null,matched=0;
  function clearSel(){wrap.querySelectorAll('.mitem.sel').forEach(x=>x.classList.remove('sel'));selL=null;}
  wrap.querySelectorAll('.mitem').forEach(it=>{it.addEventListener('click',()=>{if(it.classList.contains('done'))return;
    if(it.dataset.side==='l'){clearSel();it.classList.add('sel');selL=it;}
    else{if(!selL){fb.textContent='Pick a text on the left first ⬅';fb.className='feedback';return;}
      if(selL.dataset.k===it.dataset.k){selL.classList.add('done');it.classList.add('done');selL.classList.remove('sel');selL=null;matched++;addScore(1);
        if(matched===matchPairs.length){fb.textContent='🌟 All matched! Every text with its religion.';fb.className='feedback good';done.match=true;refreshGate();}
        else{fb.textContent='✅ Correct match!';fb.className='feedback good';}}
      else{it.classList.add('miss');const s=selL;setTimeout(()=>{it.classList.remove('miss');},400);fb.textContent='Not that pairing — try again 🤔';fb.className='feedback bad';}}
  });});
})();

// sort game: scripture vs leader/tradition
const resData=[['Qur’an','ren'],['The Pope','non'],['Bhagavad Gita','ren'],['A rabbi','non'],['Tipitaka','ren'],['The Sangha','non'],['Guru Granth Sahib','ren'],['An imam','non']];
(function(){const chips=document.getElementById('resChips');if(!chips)return;const fb=document.getElementById('fb-res');const binRen=document.getElementById('binRen'),binNon=document.getElementById('binNon');let sel=null,placed=0;resData.forEach((r,i)=>{const c=document.createElement('button');c.className='chip';c.innerHTML=r[0];c.dataset.k=r[1];c.dataset.i=i;c.addEventListener('click',()=>{chips.querySelectorAll('.chip').forEach(x=>x.classList.remove('sel'));c.classList.add('sel');sel=c;});chips.appendChild(c);});function place(binKey,binEl){if(!sel){fb.textContent='Tap a source first ⬆';fb.className='feedback';return;}if(sel.dataset.k===binKey){const tag=document.createElement('span');tag.className='placed ok';tag.innerHTML=sel.innerHTML;binEl.appendChild(tag);sel.remove();sel=null;placed++;addScore(1);fb.textContent='✅ Correct!';fb.className='feedback good';if(placed===resData.length){fb.textContent='🌟 All sorted! Texts and people/tradition both carry authority.';done.res=true;refreshGate();}}else{fb.textContent='Hmm, not that box — think again 🤔';fb.className='feedback bad';sel.classList.add('miss');setTimeout(()=>sel&&sel.classList.remove('miss'),400);}}
document.querySelector('.bin.ren').addEventListener('click',()=>place('ren',binRen));
document.querySelector('.bin.non').addEventListener('click',()=>place('non',binNon));})();

// totals
const totalPoints=document.querySelectorAll('.opts[data-q]').length
  +document.querySelectorAll('.numwrap[data-num]').length
