    <!-- 0 WELCOME -->
    <section class="screen active">
      <span class="tag">Mini-Lesson</span>
      <h1>Magnetism &amp; Electromagnetism</h1>
      <p class="big">This mini-lesson walks you through the whole of <b>AQA Topic 4.7</b>: magnetic <b>poles and fields</b>, <b>permanent vs induced</b> magnets, <b>electromagnets</b>, the <b>motor effect</b> (F = BIL), the <b>generator effect</b>, <b>transformers</b> and the <b>National Grid</b>.</p>
      <figure>
        <svg viewBox="0 0 560 200" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="A bar magnet with curved field lines emerging from the N pole and entering the S pole">
          <!-- magnet body: N (red) left, S (blue) right -->
          <rect x="215" y="86" width="65" height="44" fill="#ff5b6e" stroke="#2c2840" stroke-width="3"/>
          <rect x="280" y="86" width="65" height="44" fill="#2e8bff" stroke="#2c2840" stroke-width="3"/>
          <text x="247" y="115" text-anchor="middle" font-family="Fredoka" font-size="22" font-weight="700" fill="#fff">N</text>
          <text x="313" y="115" text-anchor="middle" font-family="Fredoka" font-size="22" font-weight="700" fill="#fff">S</text>
          <!-- field lines leave the N pole face, loop OUT, and return to the S pole face. Closest near the poles. -->
          <g fill="none" stroke="#9b5de5" stroke-width="2.5">
            <path d="M215 97 Q150 80 150 108 Q150 136 215 119"/>
            <path d="M345 97 Q410 80 410 108 Q410 136 345 119"/>
            <path d="M225 86 Q210 36 280 36 Q350 36 335 86"/>
            <path d="M225 130 Q210 180 280 180 Q350 180 335 130"/>
            <path d="M232 86 Q150 6 280 6 Q410 6 328 86"/>
            <path d="M232 130 Q150 210 280 210 Q410 210 328 130"/>
          </g>
          <!-- arrowheads ALL point away from N / toward S — the field direction OUTSIDE the magnet -->
          <g fill="#9b5de5">
            <polygon points="150,108 142,98 158,98"/>
            <polygon points="410,108 402,118 418,118"/>
            <polygon points="280,36 268,30 268,42"/>
            <polygon points="280,180 268,174 268,186"/>
            <polygon points="280,6 268,0 268,12"/>
            <polygon points="280,210 268,204 268,216"/>
          </g>
          <text x="455" y="100" font-family="Fredoka" font-size="13" font-weight="600" fill="#6a30b8">field lines</text>
          <text x="455" y="118" font-family="Nunito" font-size="11.5" fill="#6b6580">N → S outside</text>
