          <text x="310" y="119" text-anchor="middle" font-family="Fredoka" font-size="19" font-weight="700" fill="#fff">S</text>
          <g fill="none" stroke="#9b5de5" stroke-width="2.3">
            <path d="M220 102 Q160 88 160 112 Q160 136 220 122"/>
            <path d="M340 102 Q400 88 400 112 Q400 136 340 122"/>
            <path d="M230 92 Q215 44 280 44 Q345 44 330 92"/>
            <path d="M230 132 Q215 180 280 180 Q345 180 330 132"/>
            <path d="M236 92 Q160 16 280 16 Q400 16 324 92"/>
            <path d="M236 132 Q160 208 280 208 Q400 208 324 132"/>
          </g>
          <g fill="#9b5de5">
            <polygon points="160,112 152,102 168,102"/>
            <polygon points="400,112 392,122 408,122"/>
            <polygon points="280,44 268,38 268,50"/>
            <polygon points="280,180 268,174 268,186"/>
            <polygon points="280,16 268,10 268,22"/>
            <polygon points="280,208 268,202 268,214"/>
          </g>
          <!-- two plotting compasses sitting on a field line, needle aligned with it -->
          <g>
            <circle cx="160" cy="112" r="13" fill="#fff" stroke="#2c2840" stroke-width="2"/>
            <polygon points="149,112 160,108 160,116" fill="#ff5b6e"/><polygon points="171,112 160,108 160,116" fill="#2e8bff"/>
            <circle cx="400" cy="112" r="13" fill="#fff" stroke="#2c2840" stroke-width="2"/>
            <polygon points="389,112 400,108 400,116" fill="#ff5b6e"/><polygon points="411,112 400,108 400,116" fill="#2e8bff"/>
          </g>
