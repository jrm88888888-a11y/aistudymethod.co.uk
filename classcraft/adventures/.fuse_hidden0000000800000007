          <text x="150" y="84" text-anchor="middle" font-family="Fredoka" font-size="10.5" font-weight="600">core</text>
          <text x="150" y="34" text-anchor="middle" font-family="Fredoka" font-size="11" font-weight="700" fill="#0b5bbf">geographic N</text>
          <g fill="none" stroke="#9b5de5" stroke-width="2"><path d="M150 22 Q235 80 150 138"/><path d="M150 22 Q65 80 150 138"/></g>
          <text x="240" y="40" font-family="Fredoka" font-size="12.5" font-weight="600" fill="#6a30b8">The Earth behaves</text>
          <text x="240" y="60" font-family="Fredoka" font-size="12.5" font-weight="600" fill="#6a30b8">like a giant bar magnet.</text>
          <circle cx="300" cy="100" r="22" fill="#fff" stroke="#2c2840" stroke-width="2.5"/>
