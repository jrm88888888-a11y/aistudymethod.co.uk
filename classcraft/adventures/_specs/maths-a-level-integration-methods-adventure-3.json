      "term": "Partial fractions",
      "def": "Split a fraction with factored denominator into simpler ones."
    },
    {
      "term": "Distinct linear",
      "def": "1/[(x−a)(x−b)] = A/(x−a) + B/(x−b)."
    },
    {
      "term": "Repeated linear",
      "def": "1/[(x−a)²(x−b)] = A/(x−a) + B/(x−a)² + C/(x−b)."
    },
    {
      "term": "Find A, B",
      "def": "Multiply through and equate coefficients or substitute clever x."
    },
    {
      "term": "Integrate log",
      "def": "∫ 1/(x−a) dx = ln|x−a| + C."
    },
    {
      "term": "Area between curves",
      "def": "∫ (top − bottom) dx between intersections."
    }
  ],
