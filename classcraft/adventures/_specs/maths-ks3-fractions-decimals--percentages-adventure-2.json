    {
      "tag": "Percentage Change",
      "h2": "Percentage change formula",
      "body_html": "<p>% change = (change ÷ original) × 100.</p><p>If price rises from £40 to £50, change = £10. % change = (10 ÷ 40) × 100 = <strong>25%</strong>.</p>"
    }
