  "title": "Normal Nebula",
  "description": "Navigate the bell curve with z-scores and standard normal tables.",
  "concepts": [
    {
      "term": "Normal distribution",
      "def": "Bell-shaped, symmetric about mean μ, parameter σ²."
    },
    {
      "term": "Notation",
      "def": "X ~ N(μ, σ²) means X is normal with mean μ, variance σ²."
    },
    {
      "term": "Z-score",
      "def": "z = (x - μ)/σ standardises a value to N(0,1)."
    },
    {
      "term": "Empirical rule",
      "def": "About 68% within 1σ, 95% within 2σ, 99.7% within 3σ."
    },
    {
      "term": "Standard normal",
      "def": "Z ~ N(0,1); Φ(z) is its cumulative distribution."
    },
    {
      "term": "Using tables",
      "def": "Look up Φ(z) then use symmetry Φ(-z) = 1 - Φ(z)."
    }
  ],
