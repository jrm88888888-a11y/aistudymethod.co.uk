  "description": "Master the product, quotient and chain rules.",
  "concepts": [
    {
      "term": "Product rule",
      "def": "(uv)' = u'v + uv'."
    },
    {
      "term": "Quotient rule",
      "def": "(u/v)' = (u'v - uv')/v²."
    },
    {
      "term": "Chain rule",
      "def": "dy/dx = dy/du · du/dx for y = f(g(x))."
    },
    {
      "term": "When to use",
      "def": "Product for u·v; quotient for u/v; chain for nested functions."
    },
    {
      "term": "Exponential rule",
      "def": "d/dx(eˣ) = eˣ; d/dx(e^(f(x))) = f'(x)e^(f(x))."
    },
    {
      "term": "Log rule",
      "def": "d/dx(ln x) = 1/x; chain gives d/dx(ln f(x)) = f'(x)/f(x)."
    }
  ],
