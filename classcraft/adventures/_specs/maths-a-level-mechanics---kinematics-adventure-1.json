  "title": "SUVAT Speedway",
  "description": "Apply SUVAT equations to constant-acceleration problems.",
  "concepts": [
    {
      "term": "SUVAT variables",
      "def": "s = displacement, u = initial velocity, v = final velocity, a = acceleration, t = time."
    },
    {
      "term": "v = u + at",
      "def": "Final velocity after time t under constant acceleration."
    },
    {
      "term": "s = ut + ½at²",
      "def": "Displacement from initial velocity and acceleration."
    },
    {
      "term": "v² = u² + 2as",
      "def": "Connects velocities and displacement without t."
    },
    {
      "term": "s = (u+v)t/2",
      "def": "Average velocity times time = displacement."
    },
    {
      "term": "Sign conventions",
      "def": "Choose positive direction; deceleration is negative a."
    }
  ],
