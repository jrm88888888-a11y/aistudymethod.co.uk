  "title": "CLT Citadel",
  "description": "Sample means and the central limit theorem.",
  "concepts": [
    {
      "term": "Sample mean",
      "def": "X̄ = (1/n) Σ X_i for a sample of size n."
    },
    {
      "term": "Distribution of X̄",
      "def": "If X has mean μ, variance σ², then X̄ has mean μ and variance σ²/n."
    },
    {
      "term": "Central limit theorem",
      "def": "For large n, X̄ is approximately N(μ, σ²/n) regardless of X's distribution."
    },
    {
      "term": "Standard error",
      "def": "σ/√n is the standard deviation of X̄."
    },
    {
      "term": "Z-test for mean",
      "def": "z = (X̄ − μ₀)/(σ/√n) under H₀."
    },
    {
      "term": "When to use CLT",
      "def": "Typically n ≥ 30 is considered sufficient."
    }
  ],
