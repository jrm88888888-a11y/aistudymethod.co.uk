  "title": "Projectile Pathway",
  "description": "Decompose projectile motion into horizontal and vertical components.",
  "concepts": [
    {
      "term": "Independence",
      "def": "Horizontal and vertical motions are independent."
    },
    {
      "term": "Components",
      "def": "u_x = u cos α, u_y = u sin α for launch speed u, angle α."
    },
    {
      "term": "Horizontal",
      "def": "x = u_x · t; no acceleration (ignore air resistance)."
    },
    {
      "term": "Vertical",
      "def": "y = u_y t − ½g t²; acceleration −g."
    },
    {
      "term": "Time of flight",
      "def": "Set y = 0 to find t when projectile lands (level ground)."
    },
    {
      "term": "Range",
      "def": "R = (u² sin 2α)/g on level ground; max at α=45°."
    }
  ],
