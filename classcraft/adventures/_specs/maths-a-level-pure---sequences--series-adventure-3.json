  "title": "Binomial Bazaar",
  "description": "Expand binomials with Pascal's triangle and nCr coefficients.",
  "concepts": [
    {
      "term": "Binomial theorem",
      "def": "(a+b)ⁿ = Σ C(n,r) a^(n-r) b^r for non-negative integer n."
    },
    {
      "term": "nCr coefficient",
      "def": "C(n,r) = n!/[r!(n-r)!] counts ways to choose r from n."
    },
    {
      "term": "Pascal's triangle",
      "def": "Each entry is sum of the two above; row n gives C(n,0)…C(n,n)."
    },
    {
      "term": "Specific term",
      "def": "Term in b^r is C(n,r)·a^(n-r)·b^r."
    },
    {
      "term": "Symmetry",
      "def": "C(n,r) = C(n,n-r)."
    },
    {
      "term": "Negative or fractional n",
      "def": "(1+x)ⁿ has infinite series valid when |x|<1 for non-integer n."
    }
  ],
