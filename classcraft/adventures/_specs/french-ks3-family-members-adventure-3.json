    {
      "tag": "My",
      "h2": "Mon, Ma, Mes",
      "body_html": "<p>'My' changes with the gender: <strong>mon</strong> pere (m), <strong>ma</strong> mere (f), <strong>mes</strong> parents (plural). Match 'my' to the noun.</p>"
    },
