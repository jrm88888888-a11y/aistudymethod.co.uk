  "title": "Identity Isle",
  "description": "Use sin²+cos²=1 and double-angle formulas to crack trig identities.",
  "concepts": [
    {
      "term": "Pythagorean identity",
      "def": "sin²θ + cos²θ = 1 for all θ."
    },
    {
      "term": "Tangent identity",
      "def": "tan θ = sin θ / cos θ (where cos θ ≠ 0)."
    },
    {
      "term": "Double angle sin",
      "def": "sin 2θ = 2 sin θ cos θ."
    },
    {
      "term": "Double angle cos",
      "def": "cos 2θ = cos²θ - sin²θ = 1 - 2sin²θ = 2cos²θ - 1."
    },
    {
      "term": "Double angle tan",
      "def": "tan 2θ = 2tanθ / (1 - tan²θ)."
    },
    {
      "term": "R formula",
      "def": "a sinθ + b cosθ = R sin(θ+α) with R=√(a²+b²)."
    }
  ],
