{"subject": "spanish", "level": "ibdp", "topic_display": "Advanced Grammar", "topic_slug": "advanced-grammar", "theme": "languages-stamps", "adventure_n": 2, "title": "Condicional e Hipotesis", "emoji": "🔮", "welcome_lead": "The conditional expresses hypothesis and politeness. Si clauses build counterfactual scenarios.", "meta_desc": "Spanish grammar: conditional and si-clauses.", "final_note": "What if? — en espanol es el condicional.", "concepts": [{"term": "El condicional", "def": "Conditional mood."}, {"term": "Me gustaria", "def": "I would like — polite."}, {"term": "Si + imperfecto subjuntivo", "def": "If clause + imperfect subjunctive for hypothesis."}, {"term": "El condicional perfecto", "def": "Conditional perfect — would have done."}, {"term": "Si + pluscuamperfecto subjuntivo", "def": "Past hypothesis structure."}, {"term": "En caso de que", "def": "In case — triggers subjunctive."}], "walkthroughs": [{"tag": "FORM", "h2": "Forming conditional", "body_html": "<p>Infinitive + endings: -ia, -ias, -ia, -iamos, -iais, -ian. <em>Hablar > hablaria, hablarias.</em></p>"}, {"tag": "SI", "h2": "Si clause patterns", "body_html": "<p><em>Si tuviera tiempo, viajaria</em> (imperfect subjunctive + conditional). Past: <em>Si hubiera sabido, habria venido</em>.</p>"}, {"tag": "POL", "h2": "Politeness", "body_html": "<p><em>Me gustaria, querria, podria</em>. <em>?Podria ayudarme?</em></p>"}], "mcqs": [{"q": "Which expresses past hypothesis?", "options": [["Si + pluscuamperfecto subjuntivo + condicional perfecto", 1], ["Si + presente + presente", 0], ["Si + futuro + futuro", 0], ["Si + imperfecto + presente", 0]]}, {"q": "Polite Spanish for 'I would like'?", "options": [["Me gustaria", 1], ["Me gusta", 0], ["Me gustara", 0], ["Me gustaba", 0]]}], "numericals": [{"q": "How many conditional person endings?", "options": [4, 5, 6, 7], "answer": 6}], "free_texts": [{"q": "Polite Spanish for 'I would like' (two words, no accents)?", "answer": "me gustaria"}]}