  "title": "Dot Product Domain",
  "description": "Use a·b = |a||b|cosθ to find angles and check perpendicularity.",
  "concepts": [
    {
      "term": "Dot product",
      "def": "a·b = a₁b₁ + a₂b₂ + a₃b₃ — a scalar (number)."
    },
    {
      "term": "Geometric form",
      "def": "a·b = |a||b|cosθ where θ is the angle between vectors."
    },
    {
      "term": "Perpendicular test",
      "def": "If a·b = 0 and neither is zero, the vectors are perpendicular."
    },
    {
      "term": "Parallel vectors",
      "def": "a parallel to b means a = kb for some scalar k."
    },
    {
      "term": "Angle finding",
      "def": "cos θ = (a·b)/(|a||b|), then θ = arccos."
    },
    {
      "term": "Self dot",
      "def": "a·a = |a|², so magnitude squared."
    }
  ],
