  "title": "Polynomial Plateau",
  "description": "Derive polynomial derivatives directly from the limit definition.",
  "concepts": [
    {
      "term": "General xⁿ",
      "def": "Expand (x+h)ⁿ using binomial theorem; subtract xⁿ; divide by h; take limit."
    },
    {
      "term": "Binomial expansion",
      "def": "(x+h)ⁿ = xⁿ + n x^(n-1) h + O(h²)."
    },
    {
      "term": "After dividing by h",
      "def": "n x^(n-1) + (terms with h that vanish as h→0)."
    },
    {
      "term": "Result",
      "def": "d/dx(xⁿ) = n x^(n-1)."
    },
    {
      "term": "Linearity",
      "def": "Derivative of sum is sum of derivatives — provable from limit definition."
    },
    {
      "term": "Constant",
      "def": "d/dx(c) = lim (c−c)/h = 0."
    }
  ],
