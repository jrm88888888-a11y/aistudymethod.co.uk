  "title": "Limit Lookout",
  "description": "Define the derivative from first principles using limits.",
  "concepts": [
    {
      "term": "Definition",
      "def": "f'(x) = lim(h→0) [f(x+h) − f(x)] / h."
    },
    {
      "term": "Gradient of chord",
      "def": "[f(x+h)−f(x)]/h is the gradient between (x,f(x)) and (x+h,f(x+h))."
    },
    {
      "term": "h → 0",
      "def": "Limit shrinks the chord toward the tangent at x."
    },
    {
      "term": "Exists when",
      "def": "Limit must exist and be the same from left and right."
    },
    {
      "term": "Why limits?",
      "def": "Direct substitution h=0 gives 0/0; the limit resolves it."
    },
    {
      "term": "Notation",
      "def": "Sometimes written using Δx instead of h."
    }
  ],
