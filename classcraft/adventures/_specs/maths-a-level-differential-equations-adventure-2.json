  "title": "Integrating Factor Forest",
  "description": "Solve first-order linear ODEs using an integrating factor.",
  "concepts": [
    {
      "term": "Linear ODE",
      "def": "dy/dx + P(x)y = Q(x) is first-order linear."
    },
    {
      "term": "Integrating factor",
      "def": "μ(x) = e^(∫P(x)dx) makes the LHS an exact derivative."
    },
    {
      "term": "After multiplying",
      "def": "(μy)' = μQ, then integrate."
    },
    {
      "term": "General solution",
      "def": "y = (1/μ) ∫ μQ dx + C/μ."
    },
    {
      "term": "Example template",
      "def": "dy/dx + (1/x)y = 1 → μ = x, gives y = x/2 + C/x."
    },
    {
      "term": "Initial conditions",
      "def": "Plug in given y(x₀) to find C."
    }
  ],
  "walkthroughs": [
    {
      "tag": "Stop 1",
      "h2": "Find μ for dy/dx + 2y = e^x",
      "body_html": "<p class=\"big\">P(x)=2</p><p>∫2 dx = 2x μ = e^(2x)</p>"
    },
    {
      "tag": "Stop 2",
      "h2": "Solve dy/dx + y = e^x",
      "body_html": "<p class=\"big\">μ = e^x</p><p>(eˣ y)' = e^(2x) eˣ y = e^(2x)/2 + C → y = eˣ/2 + Ce^(-x)</p>"
    },
    {
      "tag": "Stop 3",
      "h2": "Solve dy/dx + (2/x)y = x, x>0",
      "body_html": "<p class=\"big\">μ = e^(2 ln x) = x²</p><p>(x²y)' = x³ x²y = x⁴/4 + C → y = x²/4 + C/x²</p>"
    }
  ],
