  "concepts": [
    {
      "term": "Arithmetic sequence",
      "def": "Each term differs by a common difference d: a, a+d, a+2d…"
    },
    {
      "term": "nth term",
      "def": "u_n = a + (n-1)d for first term a."
    },
    {
      "term": "Sum formula",
      "def": "S_n = n/2 [2a + (n-1)d]."
    },
    {
      "term": "Equivalent sum",
      "def": "S_n = n/2 (a + l) where l is the last term."
    },
    {
      "term": "Identifying d",
      "def": "d = u_{n+1} - u_n; constant for arithmetic."
    },
    {
      "term": "Σ notation",
      "def": "Σ from k=1 to n means add up terms as k varies."
    }
  ],
