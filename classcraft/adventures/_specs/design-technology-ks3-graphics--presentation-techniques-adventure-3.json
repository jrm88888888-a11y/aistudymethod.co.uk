    {
      "tag": "Colour",
      "h2": "Picking a Palette",
      "body_html": "<p>A <strong>colour palette</strong> for graphics usually has 2-4 colours: a main, a contrast, and maybe accent. Stick to it across all pages for a consistent brand feel.</p>"
    }
