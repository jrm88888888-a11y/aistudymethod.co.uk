  "walkthroughs": [
    {
      "tag": "My",
      "h2": "Mi and Mis",
      "body_html": "<p><strong>Mi</strong> = my (singular, any gender). <strong>Mis</strong> = my (plural). 'Mi hermano' (my brother), 'mis padres' (my parents).</p>"
    },
    {
      "tag": "Size",
      "h2": "In My Family",
      "body_html": "<p>'En mi familia hay cuatro personas' = 'In my family there are four people'. <strong>Hay</strong> = there is/are.</p>"
    },
    {
      "tag": "More",
      "h2": "Describing",
      "body_html": "<p>'Tengo un hermano. Se llama Tom' = 'I have a brother. His name is Tom'. Combine 'tengo' with names and ages to describe everyone.</p>"
    }
  ],
