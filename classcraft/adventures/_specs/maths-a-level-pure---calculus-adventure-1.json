  "title": "Gradient Glacier",
  "description": "Climb the icy peaks using differentiation rules to find gradients.",
  "concepts": [
    {
      "term": "Derivative meaning",
      "def": "dy/dx gives the gradient of the curve at any point."
    },
    {
      "term": "Power rule",
      "def": "If y = xⁿ then dy/dx = n·xⁿ⁻¹."
    },
    {
      "term": "Sum rule",
      "def": "Differentiate term by term: d/dx(f+g) = f' + g'."
    },
    {
      "term": "Constant rule",
      "def": "Derivative of a constant is 0; derivative of kx is k."
    },
    {
      "term": "Negative powers",
      "def": "1/x = x⁻¹, so d/dx(1/x) = -x⁻² = -1/x²."
    },
    {
      "term": "Fractional powers",
      "def": "√x = x^(1/2), so d/dx(√x) = (1/2)x^(-1/2)."
    }
  ],
