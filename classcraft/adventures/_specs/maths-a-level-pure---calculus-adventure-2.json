  "concepts": [
    {
      "term": "Indefinite integral",
      "def": "∫xⁿ dx = xⁿ⁺¹/(n+1) + C, for n ≠ -1."
    },
    {
      "term": "Constant of integration",
      "def": "Always include +C for indefinite integrals."
    },
    {
      "term": "Definite integral",
      "def": "∫ₐᵇ f(x)dx = F(b) - F(a) gives a number."
    },
    {
      "term": "Area under curve",
      "def": "Area between y=f(x) and x-axis from a to b is ∫ₐᵇ f(x)dx."
    },
    {
      "term": "Sum rule",
      "def": "∫(f+g)dx = ∫f dx + ∫g dx."
    },
    {
      "term": "Negative area",
      "def": "Curves below the x-axis give negative integrals; split into regions."
    }
  ],
