      "term": "Vector line equation",
      "def": "r = a + λb where a is a point on the line and b is the direction."
    },
    {
      "term": "Direction vector",
      "def": "Any non-zero scalar multiple of b also works as direction."
    },
    {
      "term": "Parametric form",
      "def": "x = a₁ + λb₁, y = a₂ + λb₂ etc."
    },
    {
      "term": "Point on line",
      "def": "Choose any λ; substituting gives a position on the line."
    },
    {
      "term": "Parallel lines",
      "def": "Same direction (up to scalar) and don't intersect."
    },
    {
      "term": "Intersection",
      "def": "Solve for λ and μ so r₁(λ) = r₂(μ); 3D may require all components."
    }
