    {
      "term": "Correlation r",
      "def": "Pearson r between -1 and +1: sign and strength of linear relationship."
    },
    {
      "term": "Interpretation",
      "def": "r near 1 strong positive; near -1 strong negative; near 0 weak/none."
    },
    {
      "term": "Regression line",
      "def": "y = a + bx fits 'line of best fit' minimising squared errors."
    },
    {
      "term": "Slope b",
      "def": "Expected change in y per unit change in x."
    },
    {
      "term": "Correlation vs causation",
      "def": "High r doesn't prove causation; lurking variables matter."
    }
  ],
