  "title": "Implicit Inlet",
  "description": "Differentiate implicit and parametric equations.",
  "concepts": [
    {
      "term": "Implicit form",
      "def": "Equations like x² + y² = 25 where y isn't isolated."
    },
    {
      "term": "Implicit differentiation",
      "def": "Differentiate both sides w.r.t. x; treat y as function of x."
    },
    {
      "term": "Chain on y terms",
      "def": "d/dx(y²) = 2y · dy/dx (chain rule)."
    },
    {
      "term": "Parametric form",
      "def": "x = f(t), y = g(t) describe a curve with parameter t."
    },
    {
      "term": "Parametric derivative",
      "def": "dy/dx = (dy/dt)/(dx/dt)."
    },
    {
      "term": "Why useful?",
      "def": "Implicit handles equations not solved for y; parametric handles curves traced over time."
    }
  ],
