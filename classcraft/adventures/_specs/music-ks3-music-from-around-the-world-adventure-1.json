  "walkthroughs": [
    {
      "tag": "Africa",
      "h2": "Drums and Polyrhythm",
      "body_html": "<p>African music often uses <strong>polyrhythm</strong> — several rhythms layered at once on drums like the <strong>djembe</strong>. <strong>Call and response</strong> between leader and group is everywhere.</p>"
    },
    {
      "tag": "Caribbean",
      "h2": "Reggae Beat",
      "body_html": "<p><strong>Reggae</strong> from Jamaica puts chords on the off-beats (the and) so the beat feels relaxed. <strong>Bob Marley</strong> took reggae worldwide in the 1970s.</p>"
    },
    {
      "tag": "Steel",
      "h2": "Steel Pans",
      "body_html": "<p>The <strong>steel pan</strong> was invented in Trinidad in the 1940s from oil drum lids. Whole bands play melodies and chords on these tuned pans — Carnival music.</p>"
    }
  ],
