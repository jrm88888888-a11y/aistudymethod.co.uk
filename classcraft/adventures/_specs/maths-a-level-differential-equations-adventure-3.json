  "title": "Newton's Cooling Canyon",
  "description": "Model temperatures with Newton's law of cooling.",
  "concepts": [
    {
      "term": "Cooling law",
      "def": "dT/dt = −k(T − T₀): rate proportional to excess above ambient."
    },
    {
      "term": "Separating",
      "def": "Treat as separable; integrate ln|T−T₀| = −kt + C."
    },
    {
      "term": "General solution",
      "def": "T = T₀ + Ae^(−kt) — exponential decay to ambient."
    },
    {
      "term": "Initial condition",
      "def": "T(0)=T₁ gives A = T₁ − T₀."
    },
    {
      "term": "Constant k",
      "def": "Positive constant capturing material/insulation properties."
    },
    {
      "term": "Other applications",
      "def": "Population dN/dt = rN, radioactive decay dN/dt = −λN."
    }
  ],
