  "title": "Data Den",
  "description": "Find mean, median, mode and standard deviation in the data den.",
  "concepts": [
    {
      "term": "Mean",
      "def": "Sum ÷ number of values; sensitive to outliers."
    },
    {
      "term": "Median",
      "def": "Middle value when ordered; resistant to outliers."
    },
    {
      "term": "Mode",
      "def": "Most frequent value; data may be bimodal or have no mode."
    },
    {
      "term": "Range",
      "def": "Max minus min — a simple measure of spread."
    },
    {
      "term": "Variance",
      "def": "Average squared deviation from the mean."
    },
    {
      "term": "Standard deviation",
      "def": "σ = √variance; same units as data."
    }
  ],
