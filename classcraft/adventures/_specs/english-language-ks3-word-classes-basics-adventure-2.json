  "concepts": [
    {
      "term": "Conjunction",
      "def": "Joins words, phrases or clauses."
    },
    {
      "term": "Determiner",
      "def": "Comes before a noun (the, a, my)."
    },
    {
      "term": "Article",
      "def": "A type of determiner (a, an, the)."
    },
    {
      "term": "Possessive determiner",
      "def": "'my', 'your', 'her' before a noun."
    },
    {
      "term": "Demonstrative",
      "def": "'this', 'that', 'these', 'those'."
    },
    {
      "term": "Coordinating conjunction",
      "def": "Joins equal parts (and, but, or)."
    }
  ],
  "walkthroughs": [
    {
      "tag": "Conjunctions",
      "h2": "Words that join",
      "body_html": "<p><strong>Conjunctions</strong> join: 'and', 'but', 'or' join equal parts. 'Because', 'although' join unequal parts (one depends on the other).</p>"
    },
    {
      "tag": "Determiners",
      "h2": "Pointers to nouns",
      "body_html": "<p><strong>Determiners</strong> come before nouns: <strong>articles</strong> (a, an, the), <strong>possessives</strong> (my, her), <strong>demonstratives</strong> (this, those).</p>"
    },
    {
      "tag": "Sentence example",
      "h2": "Spot them",
      "body_html": "<p>In '<em>The</em> dog ran <em>and</em> jumped', '<em>The</em>' is a determiner and '<em>and</em>' is a conjunction.</p>"
    }
  ],
