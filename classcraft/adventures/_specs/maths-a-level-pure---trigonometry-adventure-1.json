      "term": "Exact value 30°",
      "def": "sin 30° = 1/2, cos 30° = √3/2, tan 30° = 1/√3."
    },
    {
      "term": "Exact value 45°",
      "def": "sin 45° = cos 45° = √2/2, tan 45° = 1."
    },
    {
      "term": "Exact value 60°",
      "def": "sin 60° = √3/2, cos 60° = 1/2, tan 60° = √3."
    }
